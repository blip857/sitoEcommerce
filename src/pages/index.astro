---
import { getCollection } from "astro:content";

// Recuperiamo tutti i file dentro la cartella src/content/prodotti
const prodotti = await getCollection("prodotti");
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Il mio E-commerce Futursitico</title>
    <style>
      body {
        font-family: sans-serif;
        background: #f9f9f9;
        padding: 40px;
        color: #333;
      }
      h1 {
        text-align: center;
      }
      .griglia {
        display: flex;
        gap: 20px;
        justify-content: center;
        flex-wrap: wrap;
        margin-top: 40px;
      }
      .scheda-prodotto {
        background: white;
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 12px;
        width: 250px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        text-align: center;
      }
      .scheda-prodotto img {
        max-width: 100%;
        height: 200px;
        object-fit: cover;
        border-radius: 8px;
      }
      .prezzo {
        font-weight: bold;
        color: #2ecc71;
        font-size: 1.2rem;
      }
    </style>
  </head>
  <body>
    <h1>�️ Benvenuto nel mio e-commerce!</h1>

    <div class="griglia">
      {
        prodotti.map((prodotto) => (
          <div class="scheda-prodotto">
            <img src={prodotto.data.immagine} alt={prodotto.data.nome} />
            <h2>{prodotto.data.nome}</h2>
            <p class="prezzo">{prodotto.data.prezzo}€</p>
          </div>
        ))
      }
    </div>
  </body>
</html>

---
/**
 * @file ProductCard.island.astro
 * @description Client island component for rendering individual product cards.
 *              Includes interactive client-side logic for color variant image swapping on hover.
 */
import type { FormattedProduct } from '../services/products.service';

interface Props {
    product: FormattedProduct;
}

const { product } = Astro.props;
---

<article class="product-card" data-product-id={product.id}>
    <div class="image-container">
        <img
            id={`product-img-${product.id}`}
            src={product.defaultImage}
            alt={product.title}
            loading="lazy"
            class="main-product-image"
        />
    </div>

    <div class="product-info">
        {product.variants && product.variants.length > 0 && (
            <div class="color-swatches">
                {product.variants.map((variant, index) => (
                    <button
                        type="button"
                        class={`swatch-btn ${index === 0 ? 'active' : ''}`}
                        style={`background-color: ${variant.hex}; border: ${variant.hex.toLowerCase() === '#ffffff' || variant.hex.toLowerCase() === '#f5f5f5' ? '1px solid #666' : '1px solid #333'}`}
                        data-image={variant.image}
                        data-color-name={variant.name}
                        aria-label={`Select color ${variant.name}`}
                    />
                ))}
            </div>
        )}

        <h3 class="product-title">{product.title}</h3>
        <p class="product-price" data-base-price={product.price.toFixed(2)}>{product.formattedPrice}</p>
    </div>
</article>

<script>
    function setupProductCardHover() {
        const cards = document.querySelectorAll('.product-card');

        cards.forEach((card) => {
            const mainImg = card.querySelector('.main-product-image') as HTMLImageElement | null;
            const swatchBtns = card.querySelectorAll('.swatch-btn');

            if (!mainImg) return;

            swatchBtns.forEach((btn) => {
                const handleVariantChange = () => {
                    const newImgSrc = btn.getAttribute('data-image');
                    if (newImgSrc && mainImg.src !== newImgSrc) {
                        mainImg.src = newImgSrc;
                    }
                    
                    swatchBtns.forEach((b) => b.classList.remove('active'));
                    btn.classList.add('active');
                };

                btn.addEventListener('mouseenter', handleVariantChange);
                btn.addEventListener('focus', handleVariantChange);
            });
        });
    }

    function setupCurrencySelector() {
        const priceElements = document.querySelectorAll('.product-card .product-price');

        const updatePrices = (currencyStr: string) => {
            const parts = currencyStr.trim().split(" ");
            const symbol = parts[1] || parts[0];

            priceElements.forEach((el) => {
                const basePrice = el.getAttribute("data-base-price");
                if (basePrice) {
                    el.textContent = `${symbol} ${basePrice}`;
                }
            });
        };

        window.addEventListener("app:currency-change", (e: any) => {
            updatePrices(e.detail.currency);
        });

        const savedCurrency = localStorage.getItem("user-currency");
        if (savedCurrency) {
            updatePrices(savedCurrency);
        }
    }

    setupProductCardHover();
    setupCurrencySelector();
    document.addEventListener('astro:page-load', () => {
        setupProductCardHover();
        setupCurrencySelector();
    });
</script>

<style>
    .product-card {
        display: flex;
        flex-direction: column;
        background: transparent;
        transition: transform 0.2s ease;
    }

    .image-container {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #161616;
        margin-bottom: 15px;
        position: relative;
    }

    .main-product-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease, opacity 0.2s ease;
    }

    .product-card:hover .main-product-image {
        transform: scale(1.03);
    }

    .product-info {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .color-swatches {
        display: flex;
        gap: 8px;
        margin-bottom: 4px;
    }

    .swatch-btn {
        width: 14px;
        height: 14px;
        padding: 0;
        border-radius: 0;
        cursor: pointer;
        outline: none;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .swatch-btn:hover,
    .swatch-btn.active {
        transform: scale(1.25);
        outline: 1px solid #ffffff;
        outline-offset: 1px;
    }

    .product-title {
        color: #ffffff;
        font-family: sans-serif;
        font-size: 0.9rem;
        font-weight: bold;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.3;
    }

    .product-price {
        color: #999999;
        font-family: sans-serif;
        font-size: 0.85rem;
        margin: 0;
        font-weight: 500;
    }
</style>

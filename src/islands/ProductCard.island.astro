---
/**
 * @file ProductCard.island.astro
 * @description Client island component for rendering individual product cards.
 *              Includes interactive client-side logic for color variant image swapping on hover/click,
 *              and prevents event bubbling to allow navigation to detail pages.
 */
import type { FormattedProduct } from '../services/products.service';

interface Props {
    product: FormattedProduct;
}

const { product } = Astro.props;

// Determine detail page URL dynamically based on product id
let productUrl = "#";
if (product.id === "ts-01") {
    productUrl = "/products/tshirt-jefer";
}
---

<a href={productUrl} class="product-card-link flex" aria-label={`Visualizza dettagli di ${product.title}`}>
    <article class="product-card w-full border-r border-b border-zinc-800 p-4 flex flex-col justify-between bg-zinc-900 group" data-product-id={product.id}>
        
        <!-- Immagine Prodotto Rigida (Aspect Ratio 3:4 o Quadrata) -->
        <div class="w-full aspect-[3/4] overflow-hidden bg-zinc-950 mb-4">
            <img
                id={`product-img-${product.id}`}
                src={product.defaultImage}
                alt={product.title}
                loading="lazy"
                class="main-product-image w-full h-full object-cover block group-hover:scale-105 transition-transform duration-300"
            />
        </div>

        <!-- Dettagli Prodotto posizionati sotto -->
        <div class="flex flex-col gap-1.5 w-full">
            {product.variants && product.variants.length > 0 && (
                <div class="color-swatches flex gap-1 mb-1">
                    {product.variants.map((variant, index) => (
                        <button
                            type="button"
                            class={`swatch-btn w-3 h-3 block border border-zinc-700 ${index === 0 ? 'active' : ''}`}
                            style={`background-color: ${variant.hex}`}
                            data-image={variant.image}
                            data-color-name={variant.name}
                            aria-label={`Select color ${variant.name}`}
                        />
                    ))}
                </div>
            )}

            <!-- Titolo Prodotto (Sempre in UPPERCASE, font bold ma compatto) -->
            <h3 class="product-title text-xs md:text-sm font-black uppercase tracking-wider text-zinc-100 truncate">
                {product.title}
            </h3>
            
            <!-- Prezzo -->
            <p class="product-price text-xs md:text-sm text-zinc-400 font-medium" data-base-price={product.price.toFixed(2)}>
                {product.formattedPrice}
            </p>
        </div>
    </article>
</a>

<script>
    function setupProductCardHover() {
        const cards = document.querySelectorAll('.product-card');

        cards.forEach((card) => {
            const mainImg = card.querySelector('.main-product-image') as HTMLImageElement | null;
            const swatchBtns = card.querySelectorAll('.swatch-btn');

            if (!mainImg) return;

            swatchBtns.forEach((btn) => {
                const handleVariantChange = () => {
                    const newImgSrc = btn.getAttribute('data-image');
                    if (newImgSrc && mainImg.src !== newImgSrc) {
                        mainImg.src = newImgSrc;
                    }
                    
                    swatchBtns.forEach((b) => b.classList.remove('active'));
                    btn.classList.add('active');
                };

                // Change variant on hover or keyboard focus
                btn.addEventListener('mouseenter', handleVariantChange);
                btn.addEventListener('focus', handleVariantChange);

                // Prevent click on color swatch from triggering the card's <a> link navigation
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    e.preventDefault();
                    handleVariantChange();
                });
            });
        });
    }

    function setupCurrencySelector() {
        const priceElements = document.querySelectorAll('.product-card .product-price');

        const updatePrices = (currencyStr: string) => {
            const parts = currencyStr.trim().split(" ");
            const symbol = parts[1] || parts[0];

            priceElements.forEach((el) => {
                const basePrice = el.getAttribute("data-base-price");
                if (basePrice) {
                    el.textContent = `${symbol} ${basePrice}`;
                }
            });
        };

        window.addEventListener("app:currency-change", (e: any) => {
            updatePrices(e.detail.currency);
        });

        const savedCurrency = localStorage.getItem("user-currency");
        if (savedCurrency) {
            updatePrices(savedCurrency);
        }
    }

    setupProductCardHover();
    setupCurrencySelector();
    document.addEventListener('astro:page-load', () => {
        setupProductCardHover();
        setupCurrencySelector();
    });
</script>

<style>
    .product-card-link {
        text-decoration: none;
        color: inherit;
    }

    .swatch-btn {
        padding: 0;
        cursor: pointer;
        outline: none;
        transition: transform 0.15s ease, border-color 0.15s ease;
    }

    .swatch-btn:hover,
    .swatch-btn.active {
        transform: scale(1.2);
        outline: 1px solid #ffffff;
        outline-offset: 1px;
    }
</style>

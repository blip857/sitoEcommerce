---
/**
 * @file ProductView.island.astro
 * @description Client-side island component for the main product view of T-Shirt Jefer.
 *              Manages gallery image changes, color/size selection, quantity, and currency listener.
 */

interface ImageVariant {
  src: string;
  alt: string;
}

interface ColorOption {
  name: string;
  hex: string;
  images: ImageVariant[];
}

const colors: ColorOption[] = [
  {
    name: "Black",
    hex: "#111111",
    images: [
      { src: "/assets/25fwprts503_01.jpg", alt: "Jefer T-Shirt Black Front" },
      { src: "https://picsum.photos/seed/jefer-detail/800/1000", alt: "Jefer T-Shirt Black Detail" }
    ]
  },
  {
    name: "Olive",
    hex: "#4A5D4E",
    images: [
      { src: "/assets/25fwprts503_01.jpg", alt: "Jefer T-Shirt Olive Front" }
    ]
  }
];

const sizes = ["S", "M", "L", "XL"];
const basePrice = 39.00;
---

<!-- Wrapper principale: sfondo bianco, layout verticale -->
<div class="bg-white text-zinc-900 min-h-screen antialiased pt-16">
  <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 md:grid-cols-2 gap-16 items-start">

    <!-- ── COLONNA SINISTRA: Miniature verticali/orizzontali + Immagine principale ── -->
    <div class="w-full md:max-w-[500px] flex flex-col md:flex-row gap-4 items-start select-none">

      <!-- Striscia miniature (orizzontale su mobile, verticale su desktop) -->
      <div
        id="thumbnailsContainer"
        class="no-scrollbar flex flex-row md:flex-col gap-2 w-full md:w-16 shrink-0 overflow-x-auto md:overflow-y-auto max-h-[90px] md:max-h-[450px] order-2 md:order-1 snap-x snap-mandatory"
      >
        {(() => {
          let globalIdx = 0;
          return colors.flatMap((color) =>
            color.images.map((img) => {
              const currentIdx = globalIdx++;
              return (
                <button
                  type="button"
                  class={`thumb-btn transition-all duration-300 ease-in-out snap-center ${currentIdx === 0 ? "active" : ""}`}
                  data-index={currentIdx}
                  data-color={color.name}
                  aria-label={`Visualizza immagine ${color.name} ${currentIdx + 1}`}
                >
                  <img src={img.src} alt={img.alt} class="w-full h-full object-cover block" loading="lazy" />
                </button>
              );
            })
          );
        })()}
      </div>

      <!-- Contenitore immagine principale: bloccato in aspect-ratio 3:4 con slider (prima in alto su mobile) -->
      <div class="main-image-container flex-1 w-full max-w-[400px] aspect-[3/4] overflow-hidden bg-zinc-100 border border-zinc-200 relative order-1 md:order-2">
        <div id="imageSliderTrack" class="flex w-full h-full transition-transform duration-300 ease-in-out">
          {colors.flatMap((color) =>
            color.images.map((img) => (
              <img
                src={img.src}
                alt={img.alt}
                data-color={color.name}
                class="w-full h-full object-cover shrink-0 block"
              />
            ))
          )}
        </div>
      </div>

    </div>

    <!-- ── COLONNA DESTRA: Dettagli prodotto ── -->
    <div class="flex flex-col gap-6 w-full">

      <!-- Brand + Titolo + Prezzo -->
      <div class="flex flex-col gap-2">
        <p class="text-xs tracking-widest text-zinc-500 uppercase">OCCHIPIENIDI</p>
        <h1 class="text-3xl font-bold text-zinc-900 tracking-wide">JEFER T-SHIRT</h1>
        <p
          class="text-xl font-medium text-zinc-800"
          id="productPrice"
          data-base-price={basePrice.toFixed(2)}
        >
          &euro; {basePrice.toFixed(2)}
        </p>
      </div>

      <div class="border-t border-zinc-200"></div>

      <!-- Selettore Colore -->
      <div class="flex flex-col gap-3">
        <span class="text-xs tracking-widest text-zinc-500 uppercase">
          COLORE: <span id="selectedColorName" class="font-semibold text-zinc-900">{colors[0].name}</span>
        </span>
        <div class="flex gap-3">
          {colors.map((color, idx) => (
            <button
              type="button"
              class={`color-btn ${idx === 0 ? "active" : ""}`}
              style={`background-color: ${color.hex}; border: ${color.hex.toLowerCase() === '#111111' ? '1px solid #555' : '1px solid #ccc'}`}
              data-color-index={idx}
              data-color-name={color.name}
              data-images={JSON.stringify(color.images)}
              aria-label={`Seleziona colore ${color.name}`}
            />
          ))}
        </div>
      </div>

      <!-- Selettore Taglia -->
      <div class="flex flex-col gap-3">
        <label for="sizeSelector" class="text-xs tracking-widest text-zinc-500 uppercase">TAGLIA</label>
        <div class="select-wrapper">
          <select id="sizeSelector" class="size-dropdown">
            {sizes.map((size) => (
              <option value={size}>{size}</option>
            ))}
          </select>
          <span class="select-arrow">&#9660;</span>
        </div>
      </div>

      <!-- Quantità + Aggiungi al carrello -->
      <div class="flex flex-col gap-4">
        <div class="quantity-selector">
          <button type="button" class="qty-btn" id="qtyMinus" aria-label="Riduci quantità">-</button>
          <input type="number" id="qtyInput" class="qty-input" value="1" min="1" max="99" readonly />
          <button type="button" class="qty-btn" id="qtyPlus" aria-label="Aumenta quantità">+</button>
        </div>

        <button type="button" class="add-to-cart-btn btn-cart w-full" id="addToCartBtn">
          AGGIUNGI AL CARRELLO
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  function initProductView() {
    const sliderTrack = document.getElementById("imageSliderTrack");
    const thumbContainer = document.getElementById("thumbnailsContainer");
    const colorBtns = document.querySelectorAll(".color-btn");
    const selectedColorText = document.getElementById("selectedColorName");
    const qtyMinus = document.getElementById("qtyMinus");
    const qtyPlus = document.getElementById("qtyPlus");
    const qtyInput = document.getElementById("qtyInput") as HTMLInputElement | null;
    const addToCartBtn = document.getElementById("addToCartBtn");

    if (!sliderTrack || !thumbContainer || !selectedColorText || !qtyMinus || !qtyPlus || !qtyInput || !addToCartBtn) return;

    let currentIndex = 0;

    // Helper per andare a uno slide specifico e aggiornare lo stato attivo delle miniature
    function goToSlide(index: number) {
      sliderTrack!.style.transform = `translateX(-${index * 100}%)`;
      currentIndex = index;

      const thumbBtns = thumbContainer!.querySelectorAll(".thumb-btn");
      thumbBtns.forEach((btn, idx) => {
        if (idx === index) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });
    }

    // Helper per sincronizzare la palette di destra
    function syncColorPalette(colorName: string) {
      if (selectedColorText) {
        selectedColorText.textContent = colorName;
      }
      colorBtns.forEach((btn) => {
        if (btn.getAttribute("data-color-name") === colorName) {
          btn.classList.add("active");
        } else {
          btn.classList.remove("active");
        }
      });
    }

    // Delega degli eventi su click e mouseenter per le miniature
    thumbContainer.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest(".thumb-btn");
      if (btn && thumbContainer.contains(btn)) {
        const index = parseInt(btn.getAttribute("data-index") || "0", 10);
        goToSlide(index);

        const colorName = btn.getAttribute("data-color");
        if (colorName) {
          syncColorPalette(colorName);
        }
      }
    });

    thumbContainer.addEventListener("mouseover", (e) => {
      const btn = (e.target as HTMLElement).closest(".thumb-btn");
      if (btn && thumbContainer.contains(btn)) {
        const index = parseInt(btn.getAttribute("data-index") || "0", 10);
        goToSlide(index);

        const colorName = btn.getAttribute("data-color");
        if (colorName) {
          syncColorPalette(colorName);
        }
      }
    });

    // Gestione click sulla palette dei colori (destra)
    colorBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const colorName = btn.getAttribute("data-color-name");
        if (!colorName) return;

        // 1. Sincronizza lo stato attivo della palette
        syncColorPalette(colorName);

        // 2. Trova tutte le miniature e le immagini dello slider associate a questo colore
        const matchingThumbs = Array.from(
          thumbContainer.querySelectorAll(`.thumb-btn[data-color="${colorName}"]`)
        );
        const matchingSliderImgs = Array.from(
          sliderTrack.querySelectorAll(`img[data-color="${colorName}"]`)
        );

        // 3. Sposta le miniature in cima (prepend) preservando l'ordine
        for (let i = matchingThumbs.length - 1; i >= 0; i--) {
          thumbContainer.prepend(matchingThumbs[i]);
        }

        // 4. Sposta le immagini dello slider centrale in cima (prepend) preservando l'ordine
        for (let i = matchingSliderImgs.length - 1; i >= 0; i--) {
          sliderTrack.prepend(matchingSliderImgs[i]);
        }

        // 5. Riassegna gli indici "data-index" a tutte le miniature in base alla loro nuova posizione
        const allThumbs = thumbContainer.querySelectorAll(".thumb-btn");
        allThumbs.forEach((thumb, idx) => {
          thumb.setAttribute("data-index", String(idx));
        });

        // 6. Resetta lo slider a 0% e attiva la prima miniatura
        goToSlide(0);
      });
    });

    // Quantity selectors
    qtyMinus.addEventListener("click", () => {
      const val = parseInt(qtyInput!.value, 10);
      if (val > 1) qtyInput!.value = (val - 1).toString();
    });

    qtyPlus.addEventListener("click", () => {
      const val = parseInt(qtyInput!.value, 10);
      if (val < 99) qtyInput!.value = (val + 1).toString();
    });

    // Add to Cart: salva in localStorage e apre il carrello
    addToCartBtn.addEventListener("click", () => {
      const productName = document.querySelector("h1")?.textContent?.trim() || "JEFER T-SHIRT";
      const priceEl = document.getElementById("productPrice");
      const productPrice = parseFloat(priceEl?.getAttribute("data-base-price") || "39.00");
      const selectedColor = selectedColorText.textContent?.trim() || "Black";
      const selectedSize = (document.getElementById("sizeSelector") as HTMLSelectElement | null)?.value || "S";
      const quantity = parseInt(qtyInput.value, 10) || 1;

      // Trova l'immagine del colore selezionato
      const activeColorBtn = document.querySelector(".color-btn.active");
      let imgUrl = "/assets/25fwprts503_01.jpg"; // fallback
      if (activeColorBtn) {
        const imagesData = activeColorBtn.getAttribute("data-images");
        if (imagesData) {
          try {
            const imgs = JSON.parse(imagesData);
            if (imgs && imgs.length > 0) {
              imgUrl = imgs[0].src;
            }
          } catch(e) {}
        }
      }

      // Aggiorna il localStorage
      let cart = [];
      try {
        cart = JSON.parse(localStorage.getItem("cart_items") || "[]");
      } catch (e) {
        cart = [];
      }

      const existingIndex = cart.findIndex((item: any) => 
        item.name === productName && 
        item.color === selectedColor && 
        item.size === selectedSize
      );

      if (existingIndex > -1) {
        cart[existingIndex].quantity += quantity;
      } else {
        cart.push({
          name: productName,
          price: productPrice,
          color: selectedColor,
          size: selectedSize,
          quantity: quantity,
          image: imgUrl
        });
      }

      localStorage.setItem("cart_items", JSON.stringify(cart));

      // Lancia gli eventi globali per il CartDrawer
      window.dispatchEvent(new CustomEvent("cart-updated"));
      window.dispatchEvent(new CustomEvent("cart-open-request"));
    });

    // Currency selector logic
    const priceEl = document.getElementById("productPrice");
    if (priceEl) {
      const updatePrice = (currencyStr: string) => {
        const parts = currencyStr.trim().split(" ");
        const symbol = parts[1] || parts[0];
        const base = priceEl.getAttribute("data-base-price");
        if (base) priceEl.textContent = `${symbol} ${base}`;
      };

      window.addEventListener("app:currency-change", (e: any) => {
        updatePrice(e.detail.currency);
      });

      const savedCurrency = localStorage.getItem("user-currency");
      if (savedCurrency) updatePrice(savedCurrency);
    }
  }

  // Initialize on load and on Astro page transitions
  initProductView();
  document.addEventListener("astro:page-load", initProductView);
</script>

<style>
  /* ─── Miniature (blindate con !important, responsive) ─── */
  .thumb-btn {
    width: 64px !important;
    height: 64px !important; /* quadrato su mobile */
    flex-shrink: 0 !important;
    display: block !important;
    border: 1px solid #e4e4e7; /* border-zinc-200 */
    background: #f4f4f5;
    padding: 0;
    cursor: pointer;
    transition: all 0.3s ease-in-out;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .thumb-btn {
      width: 64px !important;
      height: 85px !important; /* rettangolare su desktop */
    }
  }

  .thumb-btn.active,
  .thumb-btn:hover {
    border-color: #ff9f00; /* bordo arancione come richiesto */
    transform: scale(1.02);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Scrollbar nascosta cross-browser ─── */
  #thumbnailsContainer::-webkit-scrollbar {
    display: none !important;
  }
  #thumbnailsContainer {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
  }
  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  /* ─── Hover zoom immagine principale all'interno dello slider track ─── */
  #imageSliderTrack img {
    transition: transform 0.3s ease;
  }

  .main-image-container:hover #imageSliderTrack img {
    transform: scale(1.03);
  }

  /* ─── Selettore colore ─── */
  .color-btn {
    width: 24px;
    height: 24px;
    padding: 0;
    cursor: pointer;
    position: relative;
    transition: transform 0.2s ease, outline-color 0.2s ease;
    flex-shrink: 0;
  }

  .color-btn.active,
  .color-btn:hover {
    transform: scale(1.15);
    outline: 2px solid #ff9f00;
    outline-offset: 2px;
  }

  /* ─── Size Dropdown ─── */
  .select-wrapper {
    position: relative;
    max-width: 220px;
  }

  .size-dropdown {
    width: 100%;
    background: #f4f4f5;
    color: #111;
    border: 1px solid #d4d4d4;
    padding: 12px 16px;
    font-size: 0.9rem;
    cursor: pointer;
    appearance: none;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .size-dropdown:hover,
  .size-dropdown:focus {
    border-color: #ff9f00;
  }

  .select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #888;
    font-size: 0.65rem;
    pointer-events: none;
  }

  /* ─── Quantità ─── */
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d4;
    width: fit-content;
    background: #f4f4f5;
  }

  .qty-btn {
    background: transparent;
    border: none;
    color: #111;
    width: 40px;
    height: 40px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .qty-btn:hover {
    color: #ff9f00;
  }

  .qty-input {
    width: 45px;
    height: 40px;
    background: transparent;
    border: none;
    border-left: 1px solid #d4d4d4;
    border-right: 1px solid #d4d4d4;
    color: #111;
    text-align: center;
    font-size: 0.95rem;
    appearance: textfield;
  }

  /* Rimozione spinner Firefox */
  .qty-input[type="number"] {
    -moz-appearance: textfield;
  }

  /* Rimozione spinner Chrome/Safari */
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ─── CTA Button ─── */
  .add-to-cart-btn {
    background: #ff9f00;
    color: #111111;
    border: none;
    padding: 16px 32px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .add-to-cart-btn:hover {
    background: #e08b00;
  }

  .add-to-cart-btn:active {
    transform: scale(0.98);
  }
</style>

---
/**
 * @file ProductView.island.astro
 * @description Client-side island component for the main product view of T-Shirt Jefer.
 *              Manages gallery image changes, color/size selection, quantity, and currency listener.
 */

interface ImageVariant {
  src: string;
  alt: string;
}

interface ColorOption {
  name: string;
  hex: string;
  images: ImageVariant[];
}

const colors: ColorOption[] = [
  {
    name: "Black",
    hex: "#111111",
    images: [
      { src: "/assets/25fwprts503_01.jpg", alt: "Jefer T-Shirt Black Front" },
      { src: "https://picsum.photos/seed/jefer-detail/800/1000", alt: "Jefer T-Shirt Black Detail" }
    ]
  },
  {
    name: "Olive",
    hex: "#4A5D4E",
    images: [
      { src: "/assets/25fwprts503_01.jpg", alt: "Jefer T-Shirt Olive Front" }
    ]
  }
];

const sizes = ["S", "M", "L", "XL"];
const basePrice = 39.00;
---

<!-- Griglia prodotto: sfondo bianco, 2 colonne equilibrate su desktop -->
<div class="bg-white text-zinc-900 min-h-screen">
  <div class="max-w-6xl mx-auto px-6 pt-12 pb-16 grid grid-cols-1 md:grid-cols-2 gap-12 items-start">

    <!-- Colonna Sinistra: Miniature + Immagine principale -->
    <div class="flex flex-row gap-4 items-start">

      <!-- Striscia miniature verticale -->
      <div
        class="no-scrollbar flex flex-col gap-2 w-16 shrink-0 overflow-y-auto max-h-[480px]"
        id="thumbnailsContainer"
      >
        {colors[0].images.map((img, idx) => (
          <button
            type="button"
            class={`thumb-btn ${idx === 0 ? "active" : ""}`}
            data-index={idx}
            aria-label={`Visualizza immagine ${idx + 1}`}
          >
            <img src={img.src} alt={img.alt} loading="lazy" />
          </button>
        ))}
      </div>

      <!-- Immagine principale: aspect-ratio rigido, non si espande mai -->
      <div class="main-image-container flex-1 max-w-[400px] aspect-[3/4] overflow-hidden bg-zinc-100">
        <img
          id="mainProductImage"
          src={colors[0].images[0].src}
          alt={colors[0].images[0].alt}
          class="main-img w-full h-full object-cover block"
        />
      </div>

    </div>

    <!-- Colonna Destra: Dettagli prodotto -->
    <div class="flex flex-col gap-6">

      <!-- Brand + Titolo + Prezzo -->
      <div class="flex flex-col gap-2">
        <p class="text-xs tracking-widest text-zinc-500 uppercase">OCCHIPIENIDI</p>
        <h1 class="text-3xl font-bold text-zinc-900 tracking-wide">JEFER T-SHIRT</h1>
        <p
          class="text-xl font-medium text-zinc-800"
          id="productPrice"
          data-base-price={basePrice.toFixed(2)}
        >
          &euro; {basePrice.toFixed(2)}
        </p>
      </div>

      <div class="border-t border-zinc-200"></div>

      <!-- Colore -->
      <div class="flex flex-col gap-3">
        <span class="text-xs tracking-widest text-zinc-500 uppercase">
          COLORE: <span id="selectedColorName" class="font-semibold text-zinc-900">{colors[0].name}</span>
        </span>
        <div class="flex gap-3">
          {colors.map((color, idx) => (
            <button
              type="button"
              class={`color-btn ${idx === 0 ? "active" : ""}`}
              style={`background-color: ${color.hex}; border: ${color.hex.toLowerCase() === '#111111' ? '1px solid #555' : '1px solid #ccc'}`}
              data-color-index={idx}
              data-color-name={color.name}
              data-images={JSON.stringify(color.images)}
              aria-label={`Seleziona colore ${color.name}`}
            />
          ))}
        </div>
      </div>

      <!-- Taglia -->
      <div class="flex flex-col gap-3">
        <label for="sizeSelector" class="text-xs tracking-widest text-zinc-500 uppercase">TAGLIA</label>
        <div class="select-wrapper">
          <select id="sizeSelector" class="size-dropdown">
            {sizes.map((size) => (
              <option value={size}>{size}</option>
            ))}
          </select>
          <span class="select-arrow">▼</span>
        </div>
      </div>

      <!-- Quantità + Aggiungi al carrello -->
      <div class="flex flex-col gap-4">
        <div class="quantity-selector">
          <button type="button" class="qty-btn" id="qtyMinus" aria-label="Riduci quantità">-</button>
          <input type="number" id="qtyInput" class="qty-input" value="1" min="1" max="99" readonly />
          <button type="button" class="qty-btn" id="qtyPlus" aria-label="Aumenta quantità">+</button>
        </div>

        <button type="button" class="add-to-cart-btn btn-cart w-full" id="addToCartBtn">
          AGGIUNGI AL CARRELLO
        </button>
      </div>

    </div>
  </div>
</div>

<script>
  function initProductView() {
    const mainImg = document.getElementById("mainProductImage") as HTMLImageElement | null;
    const thumbContainer = document.getElementById("thumbnailsContainer");
    const colorBtns = document.querySelectorAll(".color-btn");
    const selectedColorText = document.getElementById("selectedColorName");
    const qtyMinus = document.getElementById("qtyMinus");
    const qtyPlus = document.getElementById("qtyPlus");
    const qtyInput = document.getElementById("qtyInput") as HTMLInputElement | null;
    const addToCartBtn = document.getElementById("addToCartBtn");

    if (!mainImg || !thumbContainer || !selectedColorText || !qtyMinus || !qtyPlus || !qtyInput || !addToCartBtn) return;

    // Handle thumbnail selection
    function setupThumbnails() {
      const thumbBtns = thumbContainer.querySelectorAll(".thumb-btn");
      thumbBtns.forEach((btn) => {
        const updateMainImage = () => {
          const thumbImg = btn.querySelector("img");
          if (thumbImg && mainImg) {
            mainImg.src = thumbImg.src;
            mainImg.alt = thumbImg.alt;
          }
          thumbBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
        };

        btn.addEventListener("click", updateMainImage);
        btn.addEventListener("mouseenter", updateMainImage);
      });
    }

    setupThumbnails();

    // Handle color change
    colorBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const idx = btn.getAttribute("data-color-index");
        const colorName = btn.getAttribute("data-color-name");
        const imagesStr = btn.getAttribute("data-images");

        if (idx !== null && colorName && imagesStr) {
          // Update selected color label
          selectedColorText.textContent = colorName;

          // Update active swatch class
          colorBtns.forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");

          // Parse new color images
          const images = JSON.parse(imagesStr);

          // Rebuild thumbnails
          thumbContainer.innerHTML = images.map((img: any, i: number) => `
            <button
              type="button"
              class="thumb-btn ${i === 0 ? "active" : ""}"
              data-index="${i}"
              aria-label="Visualizza immagine ${i + 1}"
            >
              <img src="${img.src}" alt="${img.alt}" loading="lazy" />
            </button>
          `).join("");

          // Update main image to first image of new variant
          if (images.length > 0) {
            mainImg.src = images[0].src;
            mainImg.alt = images[0].alt;
          }

          // Re-attach listeners to new thumbnails
          setupThumbnails();
        }
      });
    });

    // Quantity selectors
    qtyMinus.addEventListener("click", () => {
      let val = parseInt(qtyInput.value, 10);
      if (val > 1) {
        qtyInput.value = (val - 1).toString();
      }
    });

    qtyPlus.addEventListener("click", () => {
      let val = parseInt(qtyInput.value, 10);
      if (val < 99) {
        qtyInput.value = (val + 1).toString();
      }
    });

    // Add to Cart: Simulates click on Navbar cart icon to open the drawer
    addToCartBtn.addEventListener("click", () => {
      const globalCartBtn = document.querySelector(".btn-wagen, .btn-cart:not(#addToCartBtn)") as HTMLElement | null;
      if (globalCartBtn) {
        globalCartBtn.click();
      } else {
        // Direct DOM manipulation fallback
        const cartDrawer = document.getElementById("cartDrawer");
        const cartOverlay = document.getElementById("cartOverlay");
        if (cartDrawer && cartOverlay) {
          cartDrawer.classList.add("open");
          cartOverlay.classList.add("active");
          document.body.style.overflow = "hidden";
        }
      }
    });

    // Currency selector logic
    const priceEl = document.getElementById("productPrice");
    if (priceEl) {
      const updatePrice = (currencyStr: string) => {
        const parts = currencyStr.trim().split(" ");
        const symbol = parts[1] || parts[0];
        const base = priceEl.getAttribute("data-base-price");
        if (base) {
          priceEl.textContent = `${symbol} ${base}`;
        }
      };

      window.addEventListener("app:currency-change", (e: any) => {
        updatePrice(e.detail.currency);
      });

      const savedCurrency = localStorage.getItem("user-currency");
      if (savedCurrency) {
        updatePrice(savedCurrency);
      }
    }
  }

  // Initialize
  initProductView();
  document.addEventListener("astro:page-load", initProductView);
</script>

<style>
  /* ─── Miniature ─── */
  .thumb-btn {
    width: 100%;
    aspect-ratio: 3 / 4;
    border: 1px solid #d4d4d4;
    background: #f4f4f5;
    padding: 0;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease;
    flex-shrink: 0;
    overflow: hidden;
  }

  .thumb-btn.active,
  .thumb-btn:hover {
    border-color: #ff9f00;
    transform: scale(1.02);
  }

  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ─── Immagine principale: hover zoom ─── */
  .main-img {
    transition: transform 0.3s ease;
  }

  .main-image-container:hover .main-img {
    transform: scale(1.03);
  }

  /* ─── Colore swatches ─── */
  .color-btn {
    width: 24px;
    height: 24px;
    padding: 0;
    cursor: pointer;
    position: relative;
    transition: transform 0.2s ease, outline-color 0.2s ease;
  }

  .color-btn.active,
  .color-btn:hover {
    transform: scale(1.15);
    outline: 2px solid #ff9f00;
    outline-offset: 2px;
  }

  /* ─── Size Dropdown ─── */
  .select-wrapper {
    position: relative;
    max-width: 220px;
  }

  .size-dropdown {
    width: 100%;
    background: #f4f4f5;
    color: #111;
    border: 1px solid #d4d4d4;
    padding: 12px 16px;
    font-size: 0.9rem;
    cursor: pointer;
    appearance: none;
    outline: none;
    transition: border-color 0.2s ease;
  }

  .size-dropdown:hover,
  .size-dropdown:focus {
    border-color: #ff9f00;
  }

  .select-arrow {
    position: absolute;
    right: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: #888;
    font-size: 0.65rem;
    pointer-events: none;
  }

  /* ─── Quantity ─── */
  .quantity-selector {
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d4;
    width: fit-content;
    background: #f4f4f5;
  }

  .qty-btn {
    background: transparent;
    border: none;
    color: #111;
    width: 40px;
    height: 40px;
    font-size: 1.2rem;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .qty-btn:hover {
    color: #ff9f00;
  }

  .qty-input {
    width: 45px;
    height: 40px;
    background: transparent;
    border: none;
    border-left: 1px solid #d4d4d4;
    border-right: 1px solid #d4d4d4;
    color: #111;
    text-align: center;
    font-size: 0.95rem;
    appearance: textfield;
  }

  /* Remove spinner Chrome/Safari */
  .qty-input::-webkit-outer-spin-button,
  .qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  /* ─── Scrollbar hidden Chrome/Safari ─── */
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
  }

  /* ─── CTA Button ─── */
  .add-to-cart-btn {
    background: #ff9f00;
    color: #111111;
    border: none;
    padding: 16px 32px;
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    cursor: pointer;
    text-transform: uppercase;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }

  .add-to-cart-btn:hover {
    background: #e08b00;
  }

  .add-to-cart-btn:active {
    transform: scale(0.98);
  }
</style>

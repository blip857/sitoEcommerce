---
// Componente CartDrawer per gestire il carrello a comparsa laterale
---

<div class="cart-overlay" id="cartOverlay"></div>

<div class="cart-drawer" id="cartDrawer" role="dialog" aria-modal="true" aria-labelledby="cartTitle">
    <div class="cart-header">
        <h2 id="cartTitle">CARRELLO DELLA SPESA <span class="cart-count">(0)</span></h2>
        <button class="cart-close" aria-label="Chiudi carrello">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </button>
    </div>

    <div class="cart-body">
        <p class="empty-cart-message">Il tuo carrello è vuoto</p>
    </div>
</div>

<script>
    function initCartDrawer() {
        const cartBtns = document.querySelectorAll(".btn-wagen, .btn-cart");
        const cartDrawer = document.getElementById("cartDrawer");
        const cartOverlay = document.getElementById("cartOverlay");
        const cartClose = document.querySelector(".cart-close");

        if (!cartDrawer || !cartOverlay || !cartClose) return;

        // Impedisce la registrazione di listener duplicati durante la navigazione Astro (View Transitions)
        if (cartDrawer.getAttribute("data-initialized") === "true") return;
        cartDrawer.setAttribute("data-initialized", "true");

        const openCart = (e: Event) => {
            e.preventDefault();
            cartDrawer.classList.add("open");
            cartOverlay.classList.add("active");
            document.body.style.overflow = "hidden";
        };

        const closeCart = () => {
            cartDrawer.classList.remove("open");
            cartOverlay.classList.remove("active");
            document.body.style.overflow = "";
        };

        cartBtns.forEach(btn => {
            btn.addEventListener("click", openCart);
        });

        cartClose.addEventListener("click", closeCart);
        cartOverlay.addEventListener("click", closeCart);

        // Chiudi con il tasto ESC per accessibilità
        const handleKeyDown = (e: KeyboardEvent) => {
            if (e.key === "Escape" && cartDrawer.classList.contains("open")) {
                closeCart();
            }
        };

        document.addEventListener("keydown", handleKeyDown);
    }

    // Esecuzione al primo caricamento
    initCartDrawer();

    // Re-inizializzazione su evento astro:page-load per navigazioni client-side
    document.addEventListener("astro:page-load", () => {
        const cartDrawer = document.getElementById("cartDrawer");
        if (cartDrawer) {
            cartDrawer.removeAttribute("data-initialized");
        }
        initCartDrawer();
    });
</script>

<style>
    /* Overlay oscurante sullo sfondo */
    .cart-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        z-index: 999;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .cart-overlay.active {
        opacity: 1;
        pointer-events: auto;
    }

    /* Pannello Drawer laterale */
    .cart-drawer {
        position: fixed;
        top: 0;
        right: 0;
        width: 100%;
        max-width: 440px;
        height: 100vh;
        background-color: #111111;
        z-index: 1000;
        transform: translateX(100%);
        transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        color: white;
        box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
        border-left: 1px solid #1a1a1a;
    }

    .cart-drawer.open {
        transform: translateX(0);
    }

    /* Header del Drawer */
    .cart-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 24px;
        border-bottom: 1px solid #1a1a1a;
    }

    .cart-header h2 {
        font-family: sans-serif;
        font-size: 1rem;
        font-weight: bold;
        letter-spacing: 1.5px;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .cart-count {
        color: #ff9f00;
        font-size: 0.9rem;
    }

    .cart-close {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s, transform 0.2s;
    }

    .cart-close:hover {
        color: #ff9f00;
        transform: scale(1.1);
    }

    /* Body del Drawer */
    .cart-body {
        flex-grow: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
    }

    .empty-cart-message {
        font-family: sans-serif;
        font-size: 0.95rem;
        color: #888;
        letter-spacing: 0.5px;
    }
</style>

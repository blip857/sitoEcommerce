---
// Componente CartDrawer per gestire il carrello a comparsa laterale
// Costruito interamente con Tailwind CSS v4
---

<!-- Overlay oscurante sullo sfondo -->
<div 
  class="fixed inset-0 bg-black/70 z-[999] opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out" 
  id="cartOverlay"
></div>

<!-- Pannello Drawer laterale -->
<div 
  class="fixed top-0 right-0 z-[1000] h-full w-full sm:w-[440px] bg-zinc-950 border-l border-zinc-900 transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col text-white shadow-2xl" 
  id="cartDrawer" 
  role="dialog" 
  aria-modal="true" 
  aria-labelledby="cartTitle"
>
  <!-- Header del Drawer -->
  <div class="flex justify-between items-center p-6 border-b border-zinc-900">
    <h2 id="cartTitle" class="font-bold text-xs tracking-[0.2em] text-zinc-100 uppercase flex items-center gap-2">
      CARRELLO DELLA SPESA 
      <span class="text-amber-500 font-semibold" id="cartHeaderCount">(0)</span>
    </h2>
    <button class="cart-close text-zinc-400 hover:text-amber-500 transition-colors duration-200 p-1 cursor-pointer" aria-label="Chiudi carrello">
      <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>
  </div>

  <!-- Barra di progresso per Spedizione Gratuita -->
  <div class="px-6 py-4 border-b border-zinc-900 bg-zinc-900/20">
    <p class="text-xs tracking-wider text-zinc-400 mb-2.5 font-medium" id="shippingMessage">
      Carica il carrello per calcolare la spedizione gratuita
    </p>
    <div class="w-full bg-zinc-900 h-1 rounded-full overflow-hidden">
      <div class="bg-amber-500 h-full w-0 transition-all duration-500 ease-out" id="shippingProgress"></div>
    </div>
  </div>

  <!-- Body del Drawer (Lista Prodotti o Messaggio Carrello Vuoto) -->
  <div class="flex-1 overflow-y-auto p-6 scrollbar-none" id="cartBody">
    <div class="h-full flex flex-col items-center justify-center text-center py-12" id="emptyCartState">
      <svg class="text-zinc-700 mb-4" viewBox="0 0 24 24" width="48" height="48" stroke="currentColor" stroke-width="1" fill="none">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
      </svg>
      <p class="text-sm text-zinc-500 tracking-wide">Il tuo carrello è vuoto</p>
    </div>
    
    <div class="space-y-6 hidden" id="cartItemsContainer">
      <!-- Gli elementi del carrello verranno inseriti qui tramite JavaScript -->
    </div>
  </div>

  <!-- Footer del Drawer con pulsante Pagamento -->
  <div class="border-t border-zinc-900 p-6 bg-zinc-950 space-y-4">
    <button 
      class="w-full bg-amber-500 hover:bg-amber-600 active:scale-[0.99] text-zinc-950 py-4 font-bold text-xs tracking-[0.2em] text-center transition-all duration-200 cursor-pointer uppercase disabled:opacity-50 disabled:cursor-not-allowed" 
      id="checkoutBtn"
    >
      PAGAMENTO &bull; <span id="cartTotalPrice">€0.00</span>
    </button>
  </div>
</div>

<script>
  interface CartItem {
    name: string;
    price: number;
    color: string;
    size: string;
    quantity: number;
    image: string;
  }

  const FREE_SHIPPING_THRESHOLD = 100.00;

  function initCartDrawer() {
    const cartDrawer = document.getElementById("cartDrawer");
    const cartOverlay = document.getElementById("cartOverlay");
    const cartClose = document.querySelector(".cart-close");
    const emptyState = document.getElementById("emptyCartState");
    const itemsContainer = document.getElementById("cartItemsContainer");
    const headerCount = document.getElementById("cartHeaderCount");
    const totalPriceEl = document.getElementById("cartTotalPrice");
    const shippingMessage = document.getElementById("shippingMessage");
    const shippingProgress = document.getElementById("shippingProgress");
    const checkoutBtn = document.getElementById("checkoutBtn") as HTMLButtonElement | null;

    if (!cartDrawer || !cartOverlay || !cartClose) return;

    // Impedisce la registrazione duplicata
    if (cartDrawer.getAttribute("data-initialized") === "true") return;
    cartDrawer.setAttribute("data-initialized", "true");

    // Funzione per recuperare il carrello
    function getCart(): CartItem[] {
      try {
        return JSON.parse(localStorage.getItem("cart_items") || "[]");
      } catch (e) {
        return [];
      }
    }

    // Funzione per salvare il carrello
    function saveCart(cart: CartItem[]) {
      localStorage.setItem("cart_items", JSON.stringify(cart));
      window.dispatchEvent(new CustomEvent("cart-updated"));
    }

    // Funzione per rimuovere un elemento dal carrello
    window.removeCartItem = function(index: number) {
      const cart = getCart();
      if (index >= 0 && index < cart.length) {
        cart.splice(index, 1);
        saveCart(cart);
      }
    };

    // Funzione per renderizzare gli elementi del carrello
    function renderCart() {
      const cart = getCart();
      const totalItems = cart.reduce((sum, item) => sum + item.quantity, 0);
      const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);

      // Aggiorna contatore nell'header
      if (headerCount) {
        headerCount.textContent = `(${totalItems})`;
      }

      // Aggiorna totale sul pulsante di pagamento
      if (totalPriceEl) {
        totalPriceEl.textContent = `€${totalPrice.toFixed(2)}`;
      }

      if (checkoutBtn) {
        checkoutBtn.disabled = cart.length === 0;
      }

      // Gestione barra spedizione gratuita
      if (shippingMessage && shippingProgress) {
        if (cart.length === 0) {
          shippingMessage.innerHTML = `Aggiungi articoli per ottenere la <span class="font-bold text-white">Spedizione Gratuita</span>`;
          shippingProgress.style.width = "0%";
        } else if (totalPrice >= FREE_SHIPPING_THRESHOLD) {
          shippingMessage.innerHTML = `🎉 Hai ottenuto la <span class="font-bold text-amber-500">Spedizione Gratuita</span>!`;
          shippingProgress.style.width = "100%";
        } else {
          const remaining = FREE_SHIPPING_THRESHOLD - totalPrice;
          shippingMessage.innerHTML = `Ti mancano solo <span class="font-bold text-amber-500">€${remaining.toFixed(2)}</span> per la spedizione gratuita`;
          const progressPercent = Math.min((totalPrice / FREE_SHIPPING_THRESHOLD) * 100, 100);
          shippingProgress.style.width = `${progressPercent}%`;
        }
      }

      // Gestione degli stati di vuoto/pieno
      if (cart.length === 0) {
        emptyState?.classList.remove("hidden");
        itemsContainer?.classList.add("hidden");
      } else {
        emptyState?.classList.add("hidden");
        itemsContainer?.classList.remove("hidden");

        if (itemsContainer) {
          itemsContainer.innerHTML = cart.map((item, idx) => `
            <div class="flex gap-4 border-b border-zinc-900 pb-5 last:border-b-0 last:pb-0">
              <a href="${item.url || '#'}" class="w-20 h-24 shrink-0 bg-zinc-900 border border-zinc-900 overflow-hidden block hover:opacity-80 transition-opacity duration-200">
                <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover block" />
              </a>
              
              <div class="flex-1 flex flex-col justify-between py-0.5">
                <div>
                  <div class="flex justify-between items-start gap-2">
                    <a href="${item.url || '#'}" class="hover:text-amber-500 transition-colors duration-200 block">
                      <h3 class="font-bold text-xs tracking-wider text-zinc-100 uppercase">${item.name}</h3>
                    </a>
                    <button 
                      onclick="window.removeCartItem(${idx})" 
                      class="text-zinc-500 hover:text-red-400 transition-colors duration-200 cursor-pointer p-0.5" 
                      aria-label="Rimuovi articolo"
                    >
                      <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="3 6 5 6 21 6"></polyline>
                        <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        <line x1="10" y1="11" x2="10" y2="17"></line>
                        <line x1="14" y1="11" x2="14" y2="17"></line>
                      </svg>
                    </button>
                  </div>
                  <p class="text-[10px] tracking-widest text-zinc-500 mt-1.5 uppercase font-medium">
                    TAGLIA: <span class="text-zinc-300 font-semibold">${item.size}</span> &bull; COLORE: <span class="text-zinc-300 font-semibold">${item.color}</span>
                  </p>
                </div>
                
                <div class="flex justify-between items-center mt-3">
                  <span class="text-[11px] tracking-wider text-zinc-500">QTÀ: <span class="text-zinc-300 font-semibold">${item.quantity}</span></span>
                  <span class="text-xs font-bold text-zinc-200">€${(item.price * item.quantity).toFixed(2)}</span>
                </div>
              </div>
            </div>
          `).join("");
        }
      }
    }

    const openCart = () => {
      cartDrawer.classList.remove("translate-x-full");
      cartDrawer.classList.add("translate-x-0");
      cartOverlay.classList.remove("opacity-0", "pointer-events-none");
      cartOverlay.classList.add("opacity-100", "pointer-events-auto");
      document.body.classList.add("overflow-hidden");
    };

    const closeCart = () => {
      cartDrawer.classList.remove("translate-x-0");
      cartDrawer.classList.add("translate-x-full");
      cartOverlay.classList.remove("opacity-100", "pointer-events-auto");
      cartOverlay.classList.add("opacity-0", "pointer-events-none");
      document.body.classList.remove("overflow-hidden");
    };

    // Collega i pulsanti del sito per l'apertura del carrello
    const attachGlobalCartButtons = () => {
      const cartBtns = document.querySelectorAll(".btn-wagen, .btn-cart:not(#addToCartBtn)");
      cartBtns.forEach(btn => {
        // Rimuove eventuali vecchi listener per evitare duplicati
        btn.replaceWith(btn.cloneNode(true));
      });
      
      const newCartBtns = document.querySelectorAll(".btn-wagen, .btn-cart:not(#addToCartBtn)");
      newCartBtns.forEach(btn => {
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          renderCart();
          openCart();
        });
      });
    };

    // Listener di chiusura
    cartClose.addEventListener("click", closeCart);
    cartOverlay.addEventListener("click", closeCart);

    // Chiudi con il tasto ESC
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !cartDrawer.classList.contains("translate-x-full")) {
        closeCart();
      }
    };
    document.addEventListener("keydown", handleKeyDown);

    // Ascolta aggiornamenti del carrello
    window.addEventListener("cart-updated", () => {
      renderCart();
    });

    // Ascolta e gestisce le richieste esterne di apertura esplicita
    window.addEventListener("cart-open-request", () => {
      renderCart();
      openCart();
    });

    // Renderizza lo stato iniziale del carrello al caricamento
    renderCart();
    attachGlobalCartButtons();
  }

  // Estende l'oggetto window globale con il tipo corretto per TypeScript
  declare global {
    interface Window {
      removeCartItem: (index: number) => void;
    }
  }

  // Esecuzione al caricamento iniziale
  initCartDrawer();

  // Re-inizializzazione su navigazioni client-side (Astro View Transitions)
  document.addEventListener("astro:page-load", () => {
    const cartDrawer = document.getElementById("cartDrawer");
    if (cartDrawer) {
      cartDrawer.removeAttribute("data-initialized");
    }
    initCartDrawer();
  });
</script>

<style>
  /* Nascondi scrollbar per il body del carrello */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-none {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

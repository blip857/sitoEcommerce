---
// Componente Lookbook: Citazione e Immagine Split (Stile image_7973dd.jpg)
---

<section class="brand-quote-section">
    <div class="quote-inner-container">
        <!-- COLONNA SINISTRA: Immagine ad impatto (Vibe Streetwear) -->
        <div class="quote-image-wrapper">
            <img
                src="https://images.unsplash.com/photo-1516257984-b1b4d707412e?q=80&w=600&auto=format&fit=crop"
                alt="OcchiPieniDi Lookbook Crew"
                loading="lazy"
            />
        </div>

        <!-- COLONNA DESTRA: Contenuto testuale e citazione -->
        <div class="quote-text-wrapper">
            <!-- Icona Virgolette Tradizionale -->
            <span class="editorial-virgolette">“</span>

            <blockquote class="editorial-quote">
                HO UN LOOK MOLTO ELEGANTE, IL MIO MAGLIONE È DI OCCHIPIENIDI.
            </blockquote>

            <!-- Crediti e autore in scala gerarchica -->
            <div class="quote-meta">
                <p class="meta-sub">SPORT PER ETÀ</p>
                <p class="meta-author">LuckyL</p>
            </div>
        </div>
    </div>
</section>

<style>
    .brand-quote-section {
        background-color: #111111; /* Uniformato allo sfondo scuro globale */
        padding: 60px 24px;
        width: 100%;
    }

    /* Contenitore a griglia diviso a metà esatta su desktop */
    .quote-inner-container {
        max-width: 1200px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
        align-items: center;
    }

    /* Box Immagine */
    .quote-image-wrapper {
        width: 100%;
        overflow: hidden;
    }

    .quote-image-wrapper img {
        width: 100%;
        height: auto;
        object-fit: cover;
        display: block;
        /* Opzionale: filtro leggermente desaturato per un mood ancora più industrial */
        filter: brightness(0.9);
    }

    /* Box Testo centrato */
    .quote-text-wrapper {
        text-align: center;
        color: #ffffff;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    /* Il simbolo delle virgolette alte */
    .editorial-virgolette {
        font-family: serif;
        font-size: 4.5rem;
        line-height: 1;
        color: #ffffff;
        margin-bottom: 15px;
        font-weight: bold;
    }

    /* Blocco citazione imponente e geometrico */
    .editorial-quote {
        font-family: sans-serif;
        font-size: 2.1rem;
        font-weight: 900;
        letter-spacing: 1px;
        line-height: 1.3;
        text-transform: uppercase;
        margin: 0 0 35px 0;
        max-width: 480px;
        overflow-wrap: break-word;
        word-break: break-word;
        hyphens: auto;
        -webkit-hyphens: auto;
    }

    /* Etichette autore */
    .quote-meta {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .meta-sub {
        font-family: sans-serif;
        font-size: 0.65rem;
        letter-spacing: 2px;
        color: #888888;
        margin: 0;
        text-transform: uppercase;
        font-weight: bold;
    }

    .meta-author {
        font-family: sans-serif;
        font-size: 0.85rem;
        letter-spacing: 1px;
        color: #ffffff;
        margin: 0;
        font-weight: bold;
    }

    /* ==========================================================================
     RESPONSIVE PATTERN: Stacking verticale automatico su Mobile
     ========================================================================== */
    @media (max-width: 768px) {
        .brand-quote-section {
            padding: 40px 16px;
        }

        .quote-inner-container {
            grid-template-columns: 1fr; /* Le colonne si impilano una sull'altra */
            gap: 30px;
        }

        /* Su smartphone riduciamo il testo per evitare che vada fuori schermo */
        .editorial-quote {
            font-size: 1.5rem;
            max-width: 100%;
            margin-bottom: 25px;
        }

        .editorial-virgolette {
            font-size: 3.5rem;
            margin-bottom: 5px;
        }
    }

    @media (max-width: 374px) {
        .editorial-quote {
            font-size: 1.2rem;
        }
    }
</style>

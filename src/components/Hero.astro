<section class="hero-section">
    <div class="hero-content">
        <div class="hero-graffiti-logo">
            [ LOGO GRAFFITI GRANDE MULTICOLOR ]
        </div>

        <h1 class="brand-title">ATZENSPORT<i>STUDIO</i></h1>
        <p class="brand-subtitle">ABBIGLIAMENTO GRAFFITI PER BAMBINI</p>

        <button class="cta-button">ACQUISTA ORA</button>
    </div>
</section>

<style>
    /* Layout base provvisorio a schermo intero */
    .hero-section {
        background-color: #222; /* Qui caricheremo la foto del ragazzo di spalle */
        height: 75vh;
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        font-family: serif;
    }
    .brand-title {
        font-size: 3.5rem;
        margin: 10px 0;
        letter-spacing: 1px;
    }
    .brand-title i {
        font-family: serif;
        font-style: italic;
    }
    .brand-subtitle {
        font-family: sans-serif;
        font-size: 0.8rem;
        letter-spacing: 4px;
        color: #ccc;
        margin-bottom: 30px;
    }
    .cta-button {
        background-color: #ff9f00; /* Giallo/Arancio della foto */
        color: black;
        border: none;
        padding: 15px 45px;
        font-family: sans-serif;
        font-weight: bold;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.2s;
    }
    .cta-button:hover {
        transform: scale(1.05);
    }
</style>

<script>
    function initFooterCurrencyPicker() {
        const btn = document.getElementById("footerCurrencyBtn");
        const dropdown = document.getElementById("footerCurrencyDropdown");
        const searchInput = document.getElementById(
            "footer-country-filter-input",
        ) as HTMLInputElement | null;
        const listItems = document.querySelectorAll(
            "#footerCountryList .disclosure__item",
        );
        const currentText = document.querySelector(
            ".footer-current-selected-text",
        );

        if (!btn || !dropdown || !currentText) return;

        const toggleDropdown = (show: boolean) => {
            if (show) {
                dropdown.classList.add("active");
                btn.setAttribute("aria-expanded", "true");
                if (searchInput) setTimeout(() => searchInput.focus(), 50);
            } else {
                dropdown.classList.remove("active");
                btn.setAttribute("aria-expanded", "false");
            }
        };

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleDropdown(!dropdown.classList.contains("active"));
        });

        document.addEventListener("click", (e) => {
            const target = e.target as Node;
            if (!dropdown.contains(target) && !btn.contains(target))
                toggleDropdown(false);
        });

        if (searchInput) {
            searchInput.addEventListener("input", () => {
                const term = searchInput.value.toLowerCase().trim();
                listItems.forEach((item) => {
                    const itemEl = item as HTMLElement;
                    const countrySpan = itemEl.querySelector(".country");
                    const countryName =
                        countrySpan?.textContent?.toLowerCase() || "";
                    itemEl.style.display = countryName.includes(term)
                        ? "block"
                        : "none";
                });
            });
        }

        // AGGIORNAMENTO SELEZIONE NEL FOOTER + DISPACCIO EVENTO GLOBALE
        listItems.forEach((item) => {
            const link = item.querySelector(".disclosure__link") as HTMLElement;
            if (!link) return;

            link.addEventListener("click", (e) => {
                e.preventDefault();
                const countryCode = link.getAttribute("data-value") || "IT";
                const countryName =
                    link.querySelector(".country")?.textContent?.trim() || "";
                const currencyName =
                    link
                        .querySelector(".localization-form__currency")
                        ?.textContent?.trim() || "";

                // 1. Salva lo stato localmente
                localStorage.setItem("user-country-code", countryCode);
                localStorage.setItem("user-country-name", countryName);
                localStorage.setItem("user-currency", currencyName);

                // 2. Dispaccia l'evento globale per aggiornare Navbar e Prodotti
                window.dispatchEvent(
                    new CustomEvent("app:currency-change", {
                        detail: {
                            code: countryCode,
                            name: countryName,
                            currency: currencyName,
                        },
                    }),
                );

                toggleDropdown(false);
                if (searchInput) {
                    searchInput.value = "";
                    listItems.forEach(
                        (i) => ((i as HTMLElement).style.display = "block"),
                    );
                }
            });
        });

        // Sincronizza l'interfaccia se il cambio avviene dalla Navbar
        const updateFooterUI = (
            code: string,
            name: string,
            currency: string,
        ) => {
            currentText.textContent = `${name} | ${currency}`;
            document
                .querySelectorAll(".checkmark-wrapper-footer")
                .forEach((cw) => cw.classList.add("visibility-hidden"));
            const activeLink = document.querySelector(
                `#footerCountryList .disclosure__link[data-value="${code}"]`,
            );
            activeLink
                ?.querySelector(".checkmark-wrapper-footer")
                ?.classList.remove("visibility-hidden");
        };

        window.addEventListener("app:currency-change", (e: any) => {
            const { code, name, currency } = e.detail;
            updateFooterUI(code, name, currency);
        });

        // Inizializzazione on load
        const savedCode = localStorage.getItem("user-country-code");
        const savedName = localStorage.getItem("user-country-name");
        const savedCurrency = localStorage.getItem("user-currency");

        if (savedCode && savedName && savedCurrency) {
            updateFooterUI(savedCode, savedName, savedCurrency);
        }
    }

    initFooterCurrencyPicker();
    document.addEventListener("astro:page-load", initFooterCurrencyPicker);
</script>


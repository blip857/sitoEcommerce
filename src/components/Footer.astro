                    ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                    ></line></svg
                >
            </a>
            <!-- TikTok -->
            <a href="#" aria-label="TikTok">
                <svg
                    viewBox="0 0 24 24"
                    width="22"
                    height="22"
                    stroke="currentColor"
                    stroke-width="2"
                    fill="none"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path></svg
                >
            </a>
        </div>
    </div>
</footer>

<script>
    function initFooterCurrencyPicker() {
        const btn = document.getElementById("footerCurrencyBtn");
        const dropdown = document.getElementById("footerCurrencyDropdown");
        const searchInput = document.getElementById(
            "footer-country-filter-input",
        ) as HTMLInputElement | null;
        const resetBtn = document.getElementById("footerFilterResetBtn");
        const closeBtn = document.getElementById("footerCloseDropdownBtn");
        const listItems = document.querySelectorAll(
            "#footerCountryList .disclosure__item",
        );
        const currentText = document.querySelector(
            ".footer-current-selected-text",
        );

        if (
            !btn ||
            !dropdown ||
            !searchInput ||
            !currentText ||
            !resetBtn ||
            !closeBtn
        )
            return;

        const toggleDropdown = (show: boolean) => {
            if (show) {
                dropdown.classList.add("active");
                btn.setAttribute("aria-expanded", "true");
                setTimeout(() => searchInput.focus(), 50);
            } else {
                dropdown.classList.remove("active");
                btn.setAttribute("aria-expanded", "false");
            }
        };

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleDropdown(!dropdown.classList.contains("active"));
        });

        closeBtn.addEventListener("click", () => toggleDropdown(false));

        document.addEventListener("click", (e) => {
            const target = e.target as Node;
            if (!dropdown.contains(target) && !btn.contains(target))
                toggleDropdown(false);
        });

        // Filtro Ricerca
        searchInput.addEventListener("input", () => {
            const term = searchInput.value.toLowerCase().trim();
            if (term.length > 0) {
                resetBtn.classList.remove("hidden");
            } else {
                resetBtn.classList.add("hidden");
            }

            listItems.forEach((item) => {
                const itemEl = item as HTMLElement;
                const countryName =
                    itemEl
                        .querySelector(".country")
                        ?.textContent?.toLowerCase() || "";
                itemEl.style.display = countryName.includes(term)
                    ? "block"
                    : "none";
            });
        });

        // Reset Ricerca
        resetBtn.addEventListener("click", () => {
            searchInput.value = "";
            resetBtn.classList.add("hidden");
            listItems.forEach(
                (item) => ((item as HTMLElement).style.display = "block"),
            );
            searchInput.focus();
        });

        // Selezione Voce
        listItems.forEach((item) => {
            const link = item.querySelector(".disclosure__link") as HTMLElement;
            if (!link) return;

            link.addEventListener("click", (e) => {
                e.preventDefault();
                const countryName =
                    link.querySelector(".country")?.textContent || "";
                const currencyName =
                    link.querySelector(".localization-form__currency")
                        ?.textContent || "";

                // Rispetta il formato visivo della foto "Nome Paese | Valuta"
                currentText.textContent = `${countryName} | ${currencyName.trim()}`;

                document
                    .querySelectorAll(".checkmark-wrapper-footer")
                    .forEach((cw) => cw.classList.add("visibility-hidden"));
                link.querySelector(
                    ".checkmark-wrapper-footer",
                )?.classList.remove("visibility-hidden");

                toggleDropdown(false);

                searchInput.value = "";
                resetBtn.classList.add("hidden");
                listItems.forEach(
                    (i) => ((i as HTMLElement).style.display = "block"),
                );
            });
        });
    }

    // Avvio al caricamento della pagina
    initFooterCurrencyPicker();
</script>

<style>
    /* STRUTTURA GENERALE FOOTER COMPATIBILE CON L'IMMAGINE image_ad3c2f.png */
    .site-footer {
        background-color: #0b0b0b; /* Sfondo ultra-dark */
        color: #8b8b8b; /* Scritte grigie soft */
        padding: 40px 48px;
        font-family: sans-serif;
        font-size: 0.8rem;
    }

    /* Prima Riga: Dropdown e Loghi Pagamento */
    .footer-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        flex-wrap: wrap;
        gap: 24px;
    }

    .footer-localization-block {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .localization-label {
        color: #757575;
        font-size: 0.78rem;
    }

    /* STILE DEL CASSETTO / BOTTONE */
    .currency-picker-footer {
        position: relative;
        display: inline-block;
    }

    .currency-trigger-footer {
        background: transparent;
        border: 1px solid #333;
        color: white;
        padding: 10px 16px;
        min-width: 170px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        cursor: pointer;
        font-size: 0.85rem;
        transition: border-color 0.2s;
    }

    .currency-trigger-footer:hover {
        border-color: #555;
    }

    .chevron-arrow-footer {
        font-size: 0.65rem;
        color: #8b8b8b;
        margin-left: 12px;
    }

    /* COMPORTAMENTO DROP-UP (Apertura verso l'alto!) */
    .disclosure__list-wrapper.custom-drop-up {
        position: absolute;
        bottom: calc(100% + 8px); /* Posizionato sopra il bottone */
        left: 0;
        background-color: #000000;
        border: 1px solid #222;
        width: 300px;
        display: none;
        flex-direction: column;
        box-shadow: 0px -10px 30px rgba(0, 0, 0, 0.8);
        z-index: 999;
    }
    .disclosure__list-wrapper.custom-drop-up.active {
        display: flex;
    }

    /* Barra Interna di Filtro del dropup */
    .country-filter {
        display: flex;
        align-items: center;
        padding: 10px;
        gap: 6px;
        border-bottom: 1px solid #222;
    }
    .field {
        position: relative;
        flex-grow: 1;
        display: flex;
        align-items: center;
    }
    .field__input {
        width: 100%;
        background: #111;
        border: 1px solid #444;
        color: white;
        padding: 6px 28px;
        font-size: 0.8rem;
        outline: none;
    }
    .field__input:focus {
        border-color: #ff9f00;
    }
    .field__button {
        position: absolute;
        background: none;
        border: none;
        color: #888;
        display: flex;
        align-items: center;
    }
    .country-filter__search-icon {
        left: 8px;
        pointer-events: none;
    }
    .country-filter__reset-button {
        right: 8px;
        color: white;
        cursor: pointer;
    }
    .country-filter__reset-button svg,
    .country-filter__search-icon svg {
        width: 12px;
        height: 12px;
    }
    .country-selector__close-button {
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
    }
    .country-selector__close-button svg {
        width: 14px;
        height: 14px;
    }

    /* Elementi della lista */
    .disclosure__list {
        max-height: 200px;
        overflow-y: auto;
    }
    .list-unstyled {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .disclosure__link {
        display: flex;
        align-items: center;
        padding: 8px 12px;
        color: #aaa !important;
        text-decoration: none;
        font-size: 0.85rem;
        transition: background 0.1s;
    }
    .disclosure__link:hover {
        background-color: #161616;
        color: white !important;
    }
    .checkmark-wrapper-footer {
        display: inline-flex;
        width: 14px;
        margin-right: 6px;
        color: #ff9f00;
    }
    .checkmark-wrapper-footer svg {
        width: 10px;
        height: 8px;
    }
    .country {
        flex-grow: 1;
        text-align: left;
    }
    .localization-form__currency {
        color: #555;
        font-size: 0.75rem;
        margin-left: 6px;
    }

    /* BADGES DI PAGAMENTO ESTETICI */
    .footer-payment-badges {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }
    .badge-card {
        background-color: #161616;
        border: 1px solid #292929;
        color: #ababab;
        font-size: 0.6rem;
        font-weight: bold;
        letter-spacing: 0.5px;
        padding: 4px 8px;
        border-radius: 2px;
    }
    .badge-card.bg-light {
        background-color: #e0e0e0;
        color: #000;
        border: none;
    }
    .badge-card.bg-blue {
        background-color: #4285f4;
        color: white;
        border: none;
    }
    .badge-card.bg-orange {
        background-color: #f79e1b;
        color: black;
        border: none;
    }
    .badge-card.bg-light-blue {
        background-color: #0079c1;
        color: white;
        border: none;
    }

    /* Linea orizzontale */
    .footer-divider {
        border: 0;
        border-top: 1px solid #1a1a1a;
        margin: 24px 0;
    }

    /* Copyright Row */
    .footer-middle-row {
        text-align: left;
        margin-bottom: 40px;
    }
    .footer-copyright {
        margin: 0;
        color: #6a6a6a;
        font-size: 0.75rem;
    }
    .footer-link {
        color: #6a6a6a;
        text-decoration: none;
        transition: color 0.2s;
    }
    .footer-link:hover {
        color: white;
    }
    .dot-separator {
        margin: 0 4px;
        color: #444;
    }

    /* Social Row */
    .footer-bottom-row {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }
    .social-heading {
        margin: 0;
        font-size: 0.75rem;
        letter-spacing: 2px;
        color: #8b8b8b;
        font-weight: bold;
    }
    .social-icons {
        display: flex;
        gap: 16px;
    }
    .social-icons a {
        color: #8b8b8b;
        transition: color 0.2s;
    }
    .social-icons a:hover {
        color: white;
    }

    /* Classi Utilità */
    .hidden {
        display: none !important;
    }
    .visibility-hidden {
        opacity: 0;
        pointer-events: none;
    }
    .disclosure__list::-webkit-scrollbar {
        width: 4px;
    }
    .disclosure__list::-webkit-scrollbar-track {
        background: #000;
    }
    .disclosure__list::-webkit-scrollbar-thumb {
        background: #222;
    }

    /* Responsive mobile */
    @media (max-width: 768px) {
        .footer-top-row {
            flex-direction: column;
            align-items: flex-start;
        }
        .footer-payment-badges {
            justify-content: flex-start;
            width: 100%;
        }
        .site-footer {

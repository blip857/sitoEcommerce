    // ... (Script JavaScript invariato, assicurati di tenerlo così come lo avevi)
</script>

<style>
    /* ... (Stili CSS invariati, rimuovi solo .footer-bottom-row e relativi figli se vuoi pulire il CSS) */
    .site-footer {
        background-color: #0b0b0b;
        color: #8b8b8b;
        padding: 40px 48px;
        font-family: sans-serif;
    }
    .footer-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .footer-divider {
        border: 0;
        border-top: 1px solid #1a1a1a;
        margin: 24px 0;
    }
    .footer-middle-row {
        text-align: left;
    }
</style>

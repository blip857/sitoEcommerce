<footer class="site-footer">
    <!-- SEZIONE SUPERIORE: SELETTORE E METODI DI PAGAMENTO -->
    <div class="footer-top-row">
        <!-- Scatola Selettore Paese/Regione (Allineata a Sinistra) -->
        <div class="footer-localization-block">
            <label class="localization-label">Paese/regione</label>

            <div class="currency-picker-footer">
                <button
                    class="currency-trigger-footer"
                    id="footerCurrencyBtn"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                >
                    <span class="footer-current-selected-text"
                        >Italia | EUR €</span
                    >
                    <span class="chevron-arrow-footer">▾</span>
                </button>

                <!-- Dropdown Strutturato (Apertura verso l'alto "Drop-up") -->
                <div
                    class="disclosure__list-wrapper custom-drop-up"
                    id="footerCurrencyDropdown"
                >
                    <div class="country-filter">
                        <div class="field">
                            <input
                                class="country-filter__input field__input"
                                id="footer-country-filter-input"
                                type="search"
                                placeholder="Search"
                                autocomplete="off"
                                spellcheck="false"
                            />
                            <button
                                type="reset"
                                class="country-filter__reset-button field__button hidden"
                                id="footerFilterResetBtn"
                                aria-label="Clear search"
                            >
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    class="icon icon-close"
                                    viewBox="0 0 18 18"
                                    ><circle
                                        cx="9"
                                        cy="9"
                                        r="8.5"
                                        stroke-opacity=".2"></circle><path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M11.83 11.83 6.172 6.17M6.229 11.885l5.544-5.77"
                                    ></path></svg
                                >
                            </button>
                            <div
                                class="country-filter__search-icon field__button"
                            >
                                <svg
                                    fill="none"
                                    class="icon icon-search"
                                    viewBox="0 0 18 19"
                                    ><path
                                        fill="currentColor"
                                        fill-rule="evenodd"
                                        d="M11.03 11.68A5.784 5.784 0 1 1 2.85 3.5a5.784 5.784 0 0 1 8.18 8.18m.26 1.12a6.78 6.78 0 1 1 .72-.7l5.4 5.4a.5.5 0 1 1-.71.7z"
                                        clip-rule="evenodd"></path></svg
                                >
                            </div>
                        </div>
                        <button
                            class="country-selector__close-button"
                            id="footerCloseDropdownBtn"
                            type="button"
                            aria-label="Close"
                        >
                            <svg
                                fill="none"
                                class="icon icon-close"
                                viewBox="0 0 18 17"
                                ><path
                                    fill="currentColor"
                                    d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"
                                ></path></svg
                            >
                        </button>
                    </div>

                    <div class="disclosure__list country-selector__list">
                        <ul
                            role="list"
                            class="list-unstyled countries"
                            id="footerCountryList"
                        >
                            {
                                countries.map((country) => (
                                    <li class="disclosure__item" tabindex="-1">
                                        <a
                                            class="disclosure__link"
                                            href="#"
                                            data-value={country.code}
                                            id={country.id}
                                        >
                                            <span class="checkmark-wrapper-footer visibility-hidden">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    class="icon icon-checkmark"
                                                    viewBox="0 0 12 9"

---

<footer class="site-footer">
    <div class="footer-top-row">
        <div class="footer-localization-block">
            <label class="localization-label">Paese/regione</label>
            <div class="currency-picker-footer">
                <button
                    class="currency-trigger-footer"
                    id="footerCurrencyBtn"
                    aria-haspopup="listbox"
                    aria-expanded="false"
                >
                    <span class="footer-current-selected-text"
                        >Italia | EUR €</span
                    >
                    <span class="chevron-arrow-footer">▾</span>
                </button>
                <div
                    class="disclosure__list-wrapper custom-drop-up"
                    id="footerCurrencyDropdown"
                >
                    <div class="country-filter">
                        <div class="field">
                            <input
                                class="country-filter__input field__input"
                                id="footer-country-filter-input"
                                type="search"
                                placeholder="Ricerca"
                                autocomplete="off"
                            />
                        </div>
                    </div>
                    <div class="disclosure__list country-selector__list">
                        <ul
                            role="list"
                            class="list-unstyled countries"
                            id="footerCountryList"
                        >
                            {
                                countries.map((country) => (
                                    <li class="disclosure__item" tabindex="-1">
                                        <a
                                            class="disclosure__link"
                                            href="#"
                                            data-value={country.code}
                                            id={`Footer-${country.englishName}`}
                                        >
                                            <span class="checkmark-wrapper-footer visibility-hidden">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    fill="none"
                                                    viewBox="0 0 12 9"
                                                >
                                                    <path
                                                        fill="currentColor"
                                                        fill-rule="evenodd"
                                                        d="M11.35.643a.5.5 0 0 1 .006.707l-6.77 6.886a.5.5 0 0 1-.719-.006L.638 4.845a.5.5 0 1 1 .724-.69l2.872 3.011 6.41-6.517a.5.5 0 0 1 .707-.006z"
                                                    />
                                                </svg>
                                            </span>
                                            <span class="country">
                                                {country.name}
                                            </span>
                                            <span class="localization-form__currency">
                                                {country.currency}
                                            </span>
                                        </a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-payment-badges">
            <span class="badge-card">AMEX</span>
            <span class="badge-card bg-light">APPLE PAY</span>
            <span class="badge-card">DISCOVER</span>
            <span class="badge-card bg-blue">GPAY</span>
            <span class="badge-card bg-orange">MASTERCARD</span>
            <span class="badge-card bg-light-blue">PAYPAL</span>
            <span class="badge-card bg-light">VISA</span>
        </div>
    </div>

    <hr class="footer-divider" />

    <div class="footer-middle-row">
        <p class="footer-copyright">
            © 2026, OCCHIPIENIDI Powered by Astro <span class="dot-separator"
                >·</span
            >
            <a href="#" class="footer-link">Politica sulla riservatezza</a>
            <span class="dot-separator">·</span>
            <a href="#" class="footer-link">Preferenze sui cookie</a>
        </p>
    </div>
</footer>

<script>
    // ... (Script JavaScript invariato, assicurati di tenerlo così come lo avevi)
</script>

<style>
    /* ==========================================================================
       1. POSIZIONAMENTO STRUTTURALE (IL FIX PER L'ESPLOSIONE DEL LAYOUT)
       ========================================================================== */

    /* Il contenitore principale deve essere "relative" per fare da ancora */
    .currency-picker-footer {
        position: relative;
        display: inline-block;
    }

    /* Stile del bottone trigger (se serve pulirlo) */
    .currency-trigger-footer {
        background: #111111;
        color: #ffffff;
        border: 1px solid #333333;
        padding: 8px 16px;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-width: 180px;
        text-align: left;
    }

    /* Il wrapper del menu: deve essere ASSOLUTO e con uno sfondo solido scuro */
    .disclosure__list-wrapper.custom-drop-up {
        position: absolute;
        bottom: calc(
            100% + 8px
        ); /* Lo posiziona SOPRA il bottone (Drop-up) con 8px di stacco */
        left: 0;
        width: 280px; /* Larghezza fissa per contenere comodamente testo e ricerca */
        background-color: #0b0b0b; /* Sfondo solido identico al footer per non essere trasparente */
        border: 1px solid #2a2a2a;
        box-shadow: 0px 8px 24px rgba(0, 0, 0, 0.6);
        z-index: 999; /* Evita che si posizioni sotto altri elementi */
        padding: 12px 0;

        /* Gestione visibilità iniziale: di base è nascosto */
        display: none;
    }

    /* MOSTRARE IL DROPDOWN SE ATTIVO: 
       A seconda di come funziona il tuo <script>, scommenta la regola corretta: */

    /* Alternativa A: Se il tuo JS cambia l'attributo del bottone (Best Practice accessibilità) */
    .currency-trigger-footer[aria-expanded="true"] + .disclosure__list-wrapper {
        display: block;
    }

    /* Alternativa B: Se il tuo JS aggiunge una classe ".open" o ".active" al wrapper */
    /*
    .disclosure__list-wrapper.custom-drop-up.open,
    .disclosure__list-wrapper.custom-drop-up.active {
        display: block;
    }
    */

    /* ==========================================================================
       2. STILE DELLA BARRA DI RICERCA INTERNA
       ========================================================================== */
    .country-filter {
        padding: 0 12px 10px 12px;
        border-bottom: 1px solid #1a1a1a;
        margin-bottom: 8px;
    }

    .country-filter__input.field__input {
        width: 100%;
        background-color: #161616;
        border: 1px solid #333333;
        color: #ffffff;
        padding: 8px 12px;
        font-size: 14px;
        outline: none;
        box-sizing: border-box;
    }

    .country-filter__input.field__input:focus {
        border-color: #555555;
    }

    /* ==========================================================================
       3. CORREZIONI DI LISTA E COMFORT VISIVO (PRECEDENTI + OTTIMIZZAZIONI)
       ========================================================================== */

    .disclosure__list {
        max-height: 240px; /* Limita l'altezza massima per attivare lo scroll */
        overflow-y: auto; /* Attiva la barra di scorrimento verticale */
    }

    .list-unstyled {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .disclosure__link {
        display: flex;
        align-items: center;
        justify-content: space-between; /* Allinea il nome a sx e la valuta a dx */
        gap: 10px;
        color: #cccccc;
        text-decoration: none;
        padding: 8px 16px;
        font-size: 14px;
        transition: background 0.2s ease;
    }

    .disclosure__link:hover {
        background-color: #1c1c1c;
        color: #ffffff;
    }

    .localization-form__currency {
        color: #666666; /* Rende la valuta leggermente più scura rispetto al paese */
        font-size: 13px;
    }

    /* Forza l'SVG ad avere la dimensione corretta */
    .checkmark-wrapper-footer svg {
        width: 12px;
        height: 9px;
        display: inline-block;
        vertical-align: middle;
    }

    /* Nasconde completamente le spunte non attive senza lasciare spazi vuoti */
    .visibility-hidden {
        display: none !important;
    }

    /* Stili generali del footer rimasti invariati */
    .site-footer {
        background-color: #0b0b0b;
        color: #8b8b8b;
        padding: 40px 48px;
        font-family: sans-serif;
    }
    .footer-top-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }
    .footer-divider {
        border: 0;
        border-top: 1px solid #1a1a1a;
        margin: 24px 0;
    }
    .footer-middle-row {
        text-align: left;
    }
</style>

---
/**
 * @file MarqueeBanner.astro
 * @description Horizontal sliding banner with infinite scrolling CSS animation from left to right.
 */
---

<div class="marquee-banner">
  <div class="marquee-track">
    <!-- First set of items -->
    <div class="marquee-content">
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span>Politica di reso di 14 giorni</span>
      </div>
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span>Spedizione gratuita per ordini superiori a 50 €</span>
      </div>
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Pagamento sicuro</span>
      </div>
    </div>

    <!-- Duplicate set for seamless looping (Moving left-to-right means we slide it appropriately) -->
    <div class="marquee-content" aria-hidden="true">
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
        </svg>
        <span>Politica di reso di 14 giorni</span>
      </div>
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <span>Spedizione gratuita per ordini superiori a 50 €</span>
      </div>
      <div class="marquee-item">
        <svg class="marquee-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>Pagamento sicuro</span>
      </div>
    </div>
  </div>
</div>

<style>
  .marquee-banner {
    width: 100%;
    background: #ff9f00; /* Beautiful vibrant orange for maximum premium contrast */
    color: #111111;
    overflow: hidden;
    white-space: nowrap;
    padding: 14px 0;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    border-top: 1px solid #ffaa1d;
    border-bottom: 1px solid #ea9200;
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee-animation 25s linear infinite;
  }

  .marquee-content {
    display: flex;
    justify-content: space-around;
    align-items: center;
    min-width: 100%;
    gap: 40px;
    padding-right: 40px;
  }

  .marquee-item {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: sans-serif;
    font-size: 0.85rem;
    font-weight: bold;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .marquee-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  /* Keyframe to move from Left to Right */
  @keyframes marquee-animation {
    0% {
      transform: translate3d(-50%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  /* Optional: Pause animation on hover for accessibility */
  .marquee-banner:hover .marquee-track {
    animation-play-state: paused;
  }
</style>

---
// Componente Vetrina: Classici OcchiPieniDi (Griglia a 4 colonne)
const classici = [
    {
        id: 1,
        nome: "SILAS BLAZER",
        prezzo: "39,90",
        immagine:
            "https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?q=80&w=500&auto=format&fit=crop",
        colori: [],
    },
    {
        id: 2,
        nome: "ACAB T-SHIRT",
        prezzo: "26,90",
        immagine:
            "https://images.unsplash.com/photo-1618354691373-d851c5c3a990?q=80&w=500&auto=format&fit=crop",
        colori: ["#000000", "#1e3a8a", "#ffffff"],
    },
    {
        id: 3,
        nome: "FELPA CON CAPPUCCIO HELFRI RICAMATA",
        prezzo: "49,90",
        immagine:
            "https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=500&auto=format&fit=crop",
        colori: ["#000000", "#9ca3af"],
    },
    {
        id: 4,
        nome: "FELPA ACAB",
        prezzo: "39,90",
        immagine:
            "https://images.unsplash.com/photo-1620799139507-2a76f79a2f4d?q=80&w=500&auto=format&fit=crop",
        colori: ["#9ca3af", "#000000", "#0f172a"],
    },
];
---

<section class="featured-section">
    <div class="featured-header">
        <h2 class="featured-title">CLASSICI OCCHIPIENIDI</h2>
        <a href="#" class="all-products-link">ALTRI PRODOTTI</a>
    </div>

    <div class="featured-grid">
        {
            classici.map((prodotto) => (
                <div class="product-card">
                    <div class="image-container">
                        <img
                            src={prodotto.immagine}
                            alt={prodotto.nome}
                            loading="lazy"
                        />
                    </div>

                    <div class="product-info">
                        {prodotto.colori.length > 0 && (
                            <div class="color-swatches">
                                {prodotto.colori.map((colore) => (
                                    <span
                                        class="swatch-box"
                                        style={`background-color: ${colore}; border: ${colore === "#ffffff" ? "1px solid #666" : "1px solid #333"}`}
                                    />
                                ))}
                            </div>
                        )}

                        <h3 class="product-name">{prodotto.nome}</h3>
                        {/* MODIFICATO: Aggiunto data-base-price per la gestione dinamica */}
                        <p
                            class="product-price"
                            data-base-price={prodotto.prezzo}
                        >
                            €{prodotto.prezzo}
                        </p>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<script>
    function listenToCurrencyChanges() {
        const priceElements = document.querySelectorAll(".product-price");

        const updatePrices = (currencyStr: string) => {
            // Estrae il simbolo puro (es: "USD $" -> "$", "EUR €" -> "€")
            const parts = currencyStr.trim().split(" ");
            const symbol = parts[1] || parts[0];

            priceElements.forEach((el) => {
                const basePrice = el.getAttribute("data-base-price");
                if (basePrice) {
                    // Imposta il formato corretto (es: $ 26,90)
                    el.textContent = `${symbol} ${basePrice}`;
                }
            });
        };

        // Ascolta l'evento lanciato dalla Navbar o dal Footer
        window.addEventListener("app:currency-change", (e: any) => {
            updatePrices(e.detail.currency);
        });

        // Controlla se c'è un valore pre-salvato al caricamento iniziale
        const savedCurrency = localStorage.getItem("user-currency");
        if (savedCurrency) {
            updatePrices(savedCurrency);
        }
    }

    // Esegui la logica e preservala ad ogni cambio pagina di Astro
    listenToCurrencyChanges();
    document.addEventListener("astro:page-load", listenToCurrencyChanges);
</script>

<style>
    /* ... (Il tuo CSS rimane interamente immutato) ... */
    .featured-section {
        padding: 40px 24px 60px 24px;
        background-color: #111111;
        max-width: 1200px;
        margin: 0 auto;
    }
    .featured-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 35px;
        border-bottom: 1px solid #222;
        padding-bottom: 15px;
    }
    .featured-title {
        font-family: sans-serif;
        font-size: 2.2rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: #ffffff;
        margin: 0;
        text-transform: uppercase;
    }
    .all-products-link {
        color: #ffffff;
        font-family: sans-serif;
        font-size: 0.8rem;
        font-weight: bold;
        text-decoration: underline;
        text-underline-offset: 4px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: color 0.2s;
    }
    .all-products-link:hover {
        color: #ff9f00;
    }
    .featured-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }
    .product-card {
        display: flex;
        flex-direction: column;
        background: transparent;
    }
    .image-container {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #161616;
        margin-bottom: 15px;
    }
    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .product-card:hover .image-container img {
        transform: scale(1.03);
    }
    .product-info {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .color-swatches {
        display: flex;
        gap: 6px;
        margin-bottom: 2px;
    }
    .swatch-box {
        width: 12px;
        height: 12px;
        display: inline-block;
        box-sizing: border-box;
    }
    .product-name {
        color: #ffffff;
        font-family: sans-serif;
        font-size: 0.9rem;
        font-weight: bold;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.3;
    }
    .product-price {
        color: #999999;
        font-family: sans-serif;
        font-size: 0.85rem;
        margin: 0;
        font-weight: 500;
    }
    @media (max-width: 850px) {
        .featured-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 25px;
        }
        .featured-title {
            font-size: 1.6rem;
        }
        .all-products-link {
            font-size: 0.75rem;
        }
        .featured-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }
        .product-name {
            font-size: 0.8rem;
        }
    }

    @media (max-width: 480px) {
        .featured-section {
            padding: 32px 16px 48px 16px;
        }
        .featured-grid {
            grid-template-columns: repeat(1, 1fr);
            gap: 20px;
        }
        .featured-title {
            font-size: 1.4rem;
        }
    }
</style>

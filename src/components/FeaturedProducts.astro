---
// Componente Vetrina: Classici OcchiPieniDi (Griglia a 4 colonne)

const classici = [
    {
        id: 1,
        nome: "SILAS BLAZER",
        prezzo: "39,90",
        immagine:
            "https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?q=80&w=500&auto=format&fit=crop", // Felpa grigia croma
        colori: [], // Nessun selettore visibile nello screenshot
    },
    {
        id: 2,
        nome: "ACAB T-SHIRT",
        prezzo: "26,90",
        immagine:
            "https://images.unsplash.com/photo-1618354691373-d851c5c3a990?q=80&w=500&auto=format&fit=crop", // T-shirt nera
        colori: ["#000000", "#1e3a8a", "#ffffff"], // Nero, Reale, Bianco
    },
    {
        id: 3,
        nome: "FELPA CON CAPPUCCIO HELFRI RICAMATA",
        prezzo: "49,90",
        immagine:
            "https://images.unsplash.com/photo-1556821840-3a63f95609a7?q=80&w=500&auto=format&fit=crop", // Hoodie nera
        colori: ["#000000", "#9ca3af"], // Nero, Grigio Sportivo
    },
    {
        id: 4,
        nome: "FELPA ACAB",
        prezzo: "39,90",
        immagine:
            "https://images.unsplash.com/photo-1620799139507-2a76f79a2f4d?q=80&w=500&auto=format&fit=crop", // Felpa girocollo grigia
        colori: ["#9ca3af", "#000000", "#0f172a"], // Grigio Sportivo, Nero, Marina
    },
];
---

<section class="featured-section">
    <!-- Intestazione della sezione con link laterale -->
    <div class="featured-header">
        <h2 class="featured-title">CLASSICI OCCHIPIENIDI</h2>
        <a href="#" class="all-products-link">ALTRI PRODOTTI</a>
    </div>

    <!-- Griglia Prodotti -->
    <div class="featured-grid">
        {
            classici.map((prodotto) => (
                <div class="product-card">
                    <div class="image-container">
                        <img
                            src={prodotto.immagine}
                            alt={prodotto.nome}
                            loading="lazy"
                        />
                    </div>

                    <div class="product-info">
                        {/* Mostra i quadratini dei colori solo se presenti nell'array */}
                        {prodotto.colori.length > 0 && (
                            <div class="color-swatches">
                                {prodotto.colori.map((colore) => (
                                    <span
                                        class="swatch-box"
                                        style={`background-color: ${colore}; border: ${colore === "#ffffff" ? "1px solid #666" : "1px solid #333"}`}
                                    />
                                ))}
                            </div>
                        )}

                        <h3 class="product-name">{prodotto.nome}</h3>
                        <p class="product-price">€{prodotto.prezzo}</p>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    /* ... (Mantieni inalterati gli stili base del Desktop scritti in precedenza) ... */
    .featured-section {
        padding: 40px 24px 60px 24px;
        background-color: #111111;
        max-width: 1200px;
        margin: 0 auto;
    }
    .featured-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 35px;
        border-bottom: 1px solid #222;
        padding-bottom: 15px;
    }
    .featured-title {
        font-family: sans-serif;
        font-size: 2.2rem;
        font-weight: 900;
        letter-spacing: 1px;
        color: #ffffff;
        margin: 0;
        text-transform: uppercase;
    }
    .all-products-link {
        color: #ffffff;
        font-family: sans-serif;
        font-size: 0.8rem;
        font-weight: bold;
        text-decoration: underline;
        text-underline-offset: 4px;
        letter-spacing: 1px;
        text-transform: uppercase;
        transition: color 0.2s;
    }
    .all-products-link:hover {
        color: #ff9f00;
    }
    .featured-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 24px;
    }
    .product-card {
        display: flex;
        flex-direction: column;
        background: transparent;
    }
    .image-container {
        width: 100%;
        aspect-ratio: 1 / 1;
        overflow: hidden;
        background-color: #161616;
        margin-bottom: 15px;
    }
    .image-container img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }
    .product-card:hover .image-container img {
        transform: scale(1.03);
    }
    .product-info {
        text-align: left;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .color-swatches {
        display: flex;
        gap: 6px;
        margin-bottom: 2px;
    }
    .swatch-box {
        width: 12px;
        height: 12px;
        display: inline-block;
        box-sizing: border-box;
    }
    .product-name {
        color: #ffffff;
        font-family: sans-serif;
        font-size: 0.9rem;
        font-weight: bold;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        line-height: 1.3;
    }
    .product-price {
        color: #999999;
        font-family: sans-serif;
        font-size: 0.85rem;
        margin: 0;
        font-weight: 500;
    }

    /* ==========================================================================
     STRATEGIA RESPONSIVE AGGIORNATA (Stile image_79e113.png)
     ========================================================================== */
    @media (max-width: 850px) {
        /* Sposta il link "ALTRI PRODOTTI" sotto il titolo */
        .featured-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
            margin-bottom: 25px;
        }

        .featured-title {
            font-size: 1.6rem;
        }

        .all-products-link {
            font-size: 0.75rem;
        }

        /* Mantiene tassativamente la struttura a 2 colonne parallele */
        .featured-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 16px;
        }

        .product-name {
            font-size: 0.8rem;
        }
    }
</style>

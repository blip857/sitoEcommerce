---
/**
 * @file VestiarioHero.astro
 * @description Static presenter hero section for the Vestiario page.
 *              Displays a dark, minimalist full-width banner with centered title.
 */
---

<section class="vestiario-hero">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="hero-title">VESTIARIO</h1>
    </div>
</section>

<style>
    .vestiario-hero {
        position: relative;
        height: 45vh;
        min-height: 320px;
        width: 100%;
        display: flex;
        justify-content: flex-start;
        align-items: flex-end;
        text-align: left;
        background: linear-gradient(rgba(17, 17, 17, 0.75), rgba(17, 17, 17, 0.85)), url('/assets/25fwprts503_01.jpg') no-repeat center center;
        background-size: cover;
        overflow: hidden;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.2);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        width: 100%;
        padding: 0 48px 48px;
        box-sizing: border-box;
    }

    .hero-title {
        font-family: 'Outfit', 'Inter', sans-serif;
        font-size: 4rem;
        font-weight: 900;
        letter-spacing: 8px;
        color: #ffffff;
        margin: 0;
        text-transform: uppercase;
        text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    }

    @media (max-width: 768px) {
        .vestiario-hero {
            height: 35vh;
            min-height: 250px;
            background-position: center top;
        }

        .hero-content {
            padding: 0 24px 24px;
            overflow: hidden;
        }

        .hero-title {
            font-size: 2.5rem;
            letter-spacing: 4px;
            word-break: break-word;
        }
    }

    @media (max-width: 374px) {
        .hero-title {
            font-size: 2rem;
            letter-spacing: 2px;
        }
    }
</style>

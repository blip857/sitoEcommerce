---
/**
 * @file Preloader.astro
 * @description Preloader in stile Basement Studio con supporto alle animazioni SVG.
 */
---

<!-- Preloader overlay — visible immediately, before any other DOM is rendered -->
<div id="preloader">
  <svg id="scribble-svg" preserveAspectRatio="none"></svg>
  
  <div class="preloader-hero-align">
    <div class="hero-content-ghost">
      <div class="hero-graffiti-logo-ghost" aria-hidden="true">[ LOGO GRAFFITI GRANDE MULTICOLOR ]</div>
      <div class="preloader-word" id="preloaderWord">OCCHIPIENIDI<i>STUDIO</i></div>
      <div class="brand-subtitle-ghost" aria-hidden="true">ABBIGLIAMENTO GRAFFITI</div>
      <button class="cta-button-ghost" aria-hidden="true" tabindex="-1">ACQUISTA ORA</button>
    </div>
  </div>

  <button class="preloader-skip" id="skipBtn">Salta</button>
</div>

<style>
  /* CSS custom properties scoped to the preloader.
     Prefixed with --pl- to avoid collisions with site-wide :root variables. */
  :root {
    --pl-bg:     #0a0a0a;
    --pl-ink:    #ffffff;
    --pl-line:   rgba(245, 245, 240, 0.55);
    --pl-accent: #d6d6ce;
  }

  /* ── Overlay ─────────────────────────────────────────────────────────────── */
  #preloader {
    position: fixed;
    inset: 0;
    background: var(--pl-bg);
    display: block;
    z-index: 9999;
    /* overflow:hidden prevents SVG coordinate rounding from adding a scrollbar
       on mobile (especially on Android Chrome with address-bar resize) */
    overflow: hidden;
    transition: opacity 0.9s ease, visibility 0.9s ease;
  }

  #preloader.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* ── SVG canvas ──────────────────────────────────────────────────────────── */
  #scribble-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Default path styling — mirrors the reference exactly.
     stroke-width is also set per-path via JS for per-line randomness. */
  #scribble-svg path {
    fill: none !important;          /* guard against Tailwind/global resets */
    stroke: var(--pl-line, rgba(245, 245, 240, 0.55)) !important; /* guard against Tailwind/global resets */
    stroke-width: 1;
    stroke-linecap: round;
  }

  /* ── Hero Alignment Container ────────────────────────────────────────────── */
  .preloader-hero-align {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 80vh; /* Mirrors .hero-section height */
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    pointer-events: none;
    z-index: 2;
  }

  .hero-content-ghost {
    position: relative;
    z-index: 3;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .hero-graffiti-logo-ghost {
    font-family: sans-serif;
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin-bottom: 10px;
    visibility: hidden;
    user-select: none;
  }

  /* ── Brand word (Typography 1:1 match with Hero .brand-title) ───────────── */
  .preloader-word {
    position: relative;
    color: var(--pl-ink);
    font-family: serif;
    font-size: 3.5rem;
    font-weight: bold;
    margin: 15px 0;
    letter-spacing: 1px;
    text-transform: uppercase;
    line-height: 1.1;
    /* initial hidden state */
    opacity: 0;
    transform: scale(0.88);
    filter: blur(6px);
    transition: opacity 0.7s ease, transform 0.7s ease, filter 0.7s ease;
    max-width: 90vw;
    text-align: center;
    pointer-events: auto;
  }

  .preloader-word i {
    font-style: italic;
  }

  .preloader-word.show {
    opacity: 1;
    transform: scale(1);
    filter: blur(0);
  }

  /* Ghost elements for exact flexbox vertical alignment */
  .brand-subtitle-ghost {
    font-family: sans-serif;
    font-size: 0.85rem;
    letter-spacing: 5px;
    margin-bottom: 35px;
    text-transform: uppercase;
    font-weight: bold;
    visibility: hidden;
    user-select: none;
  }

  .cta-button-ghost {
    padding: 16px 48px;
    font-family: sans-serif;
    font-weight: bold;
    font-size: 0.95rem;
    letter-spacing: 1px;
    text-transform: uppercase;
    border: none;
    visibility: hidden;
    user-select: none;
  }

  /* ── Skip button ─────────────────────────────────────────────────────────── */
  .preloader-skip {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pl-accent);
    background: none;
    border: 1px solid rgba(245, 245, 240, 0.25);
    padding: 8px 14px;
    border-radius: 999px;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity 0.2s ease, border-color 0.2s ease;
    z-index: 10;
  }

  .preloader-skip:hover {
    opacity: 1;
    border-color: rgba(245, 245, 240, 0.6);
  }

  /* ── Accessibility & Responsive Alignment (matching Hero.astro) ───────── */
  @media (max-width: 768px) {
    .preloader-hero-align {
      height: 65vh; /* Mirrors .hero-section height on mobile */
    }
    .preloader-word {
      font-size: 2.2rem;
    }
    .brand-subtitle-ghost {
      font-size: 0.75rem;
      letter-spacing: 3px;
    }
    .cta-button-ghost {
      padding: 14px 32px;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #preloader       { transition: opacity 0.3s ease; }
    .preloader-word  { transition: opacity 0.3s ease; transform: none; filter: none; }
  }
</style>

<script is:inline>
  (function () {
    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function hidePreloader() {
      var container = document.getElementById("preloader");
      if (container && !container.classList.contains("hide")) {
        container.classList.add("hide");
        // Rimuove l'elemento dal DOM dopo la transizione CSS (0.9s)
        setTimeout(function () {
          if (container.parentNode) {
            container.parentNode.removeChild(container);
          }
        }, 900);
      }
    }

    // Trigger visual text
    function showText() {
      var el = document.getElementById("preloaderWord");
      if (el) el.classList.add("show");
    }

    function buildScribble() {
      var svgEl = document.getElementById("scribble-svg");
      if (!svgEl) return;

      while (svgEl.firstChild) {
        svgEl.removeChild(svgEl.firstChild);
      }

      var rect = svgEl.getBoundingClientRect();
      var w = rect.width || window.innerWidth || 1280;
      var h = rect.height || window.innerHeight || 720;

      svgEl.setAttribute("viewBox", "0 0 " + w + " " + h);

      var lineCount = Math.floor(rand(22, 28));
      var paths = [];

      for (var i = 0; i < lineCount; i++) {
        var path = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "path",
        );

        var startX = rand(-0.1, 1.1) * w;
        var startY = rand(-0.1, 1.1) * h;
        var cp1x = rand(0, 1) * w;
        var cp1y = rand(0, 1) * h;
        var cp2x = rand(0, 1) * w;
        var cp2y = rand(0, 1) * h;
        var endX = rand(-0.1, 1.1) * w;
        var endY = rand(-0.1, 1.1) * h;

        var d =
          "M " +
          startX +
          " " +
          startY +
          " C " +
          cp1x +
          " " +
          cp1y +
          ", " +
          cp2x +
          " " +
          cp2y +
          ", " +
          endX +
          " " +
          endY;

        path.setAttribute("d", d);
        path.style.stroke = "rgba(245, 245, 240, 0.55)";
        path.style.strokeWidth = rand(0.8, 1.8).toFixed(2);
        path.style.fill = "none";

        svgEl.appendChild(path);
        paths.push(path);
      }

      var maxAnimTime = 0;

      for (var k = 0; k < paths.length; k++) {
        (function (p, idx) {
          var len = p.getTotalLength();
          if (len === 0) len = 2000;

          p.style.strokeDasharray = len;
          p.style.strokeDashoffset = len;
          p.style.transition = "none";

          p.getBoundingClientRect();

          var delay = idx * 35;
          var duration = rand(650, 1100);
          var totalPathTime = delay + duration;
          if (totalPathTime > maxAnimTime) maxAnimTime = totalPathTime;

          setTimeout(function () {
            p.style.transition =
              "stroke-dashoffset " +
              duration +
              "ms cubic-bezier(0.65, 0, 0.35, 1)";
            p.style.strokeDashoffset = "0";
          }, delay);
        })(paths[k], k);
      }

      // Trigger text reveal
      setTimeout(showText, 150);

      // Gestione scomparsa al termine dei caricamenti o via timer
      var minShowTime = maxAnimTime + 200; // Garantisce che l'animazione delle linee completi

      function triggerExit() {
        setTimeout(hidePreloader, minShowTime);
      }

      if (document.readyState === "complete") {
        triggerExit();
      } else {
        window.addEventListener("load", triggerExit, { once: true });
        // Fallback max 3 secondi nel caso l'evento 'load' tardi a scattare
        setTimeout(hidePreloader, 3000);
      }
    }

    function init() {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          setTimeout(buildScribble, 50);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

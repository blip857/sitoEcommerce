---
/**
 * @file Preloader.astro
 * @description Preloader in stile Basement Studio con supporto alle animazioni SVG.
 */
---

<div id="preloader-container" class="preloader-overlay">
  <svg id="scribble-svg" preserveAspectRatio="none"></svg>
  <div class="preloader-content">
    <span class="preloader-brand">LOADING</span>
  </div>
</div>

<style>
  .preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: #0a0a0a;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    transition:
      opacity 0.6s cubic-bezier(0.65, 0, 0.35, 1),
      visibility 0.6s ease;
  }

  .preloader-overlay.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  #scribble-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  :global(#scribble-svg path) {
    fill: none !important;
    stroke: rgba(245, 245, 240, 0.55) !important;
    stroke-linecap: round;
  }

  .preloader-content {
    position: relative;
    z-index: 2;
  }

  .preloader-brand {
    font-family: system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: #f5f5f0;
  }
</style>

<script is:inline>
  (function () {
    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function hidePreloader() {
      var container = document.getElementById("preloader-container");
      if (container && !container.classList.contains("is-hidden")) {
        container.classList.add("is-hidden");
        // Rimuove l'elemento dal DOM dopo la transizione CSS (0.6s) per liberare memoria
        setTimeout(function () {
          if (container.parentNode) {
            container.parentNode.removeChild(container);
          }
        }, 600);
      }
    }

    function buildScribble() {
      var svgEl = document.getElementById("scribble-svg");
      if (!svgEl) return;

      while (svgEl.firstChild) {
        svgEl.removeChild(svgEl.firstChild);
      }

      var rect = svgEl.getBoundingClientRect();
      var w = rect.width || window.innerWidth || 1280;
      var h = rect.height || window.innerHeight || 720;

      svgEl.setAttribute("viewBox", "0 0 " + w + " " + h);

      var lineCount = Math.floor(rand(22, 28));
      var paths = [];

      for (var i = 0; i < lineCount; i++) {
        var path = document.createElementNS(
          "http://www.w3.org/2000/svg",
          "path",
        );

        var startX = rand(-0.1, 1.1) * w;
        var startY = rand(-0.1, 1.1) * h;
        var cp1x = rand(0, 1) * w;
        var cp1y = rand(0, 1) * h;
        var cp2x = rand(0, 1) * w;
        var cp2y = rand(0, 1) * h;
        var endX = rand(-0.1, 1.1) * w;
        var endY = rand(-0.1, 1.1) * h;

        var d =
          "M " +
          startX +
          " " +
          startY +
          " C " +
          cp1x +
          " " +
          cp1y +
          ", " +
          cp2x +
          " " +
          cp2y +
          ", " +
          endX +
          " " +
          endY;

        path.setAttribute("d", d);
        path.style.stroke = "rgba(245, 245, 240, 0.55)";
        path.style.strokeWidth = rand(0.8, 1.8).toFixed(2);
        path.style.fill = "none";

        svgEl.appendChild(path);
        paths.push(path);
      }

      var maxAnimTime = 0;

      for (var k = 0; k < paths.length; k++) {
        (function (p, idx) {
          var len = p.getTotalLength();
          if (len === 0) len = 2000;

          p.style.strokeDasharray = len;
          p.style.strokeDashoffset = len;
          p.style.transition = "none";

          p.getBoundingClientRect();

          var delay = idx * 35;
          var duration = rand(650, 1100);
          var totalPathTime = delay + duration;
          if (totalPathTime > maxAnimTime) maxAnimTime = totalPathTime;

          setTimeout(function () {
            p.style.transition =
              "stroke-dashoffset " +
              duration +
              "ms cubic-bezier(0.65, 0, 0.35, 1)";
            p.style.strokeDashoffset = "0";
          }, delay);
        })(paths[k], k);
      }

      // Gestione scomparsa al termine dei caricamenti o via timer
      var minShowTime = maxAnimTime + 200; // Garantisce che l'animazione delle linee completi

      function triggerExit() {
        setTimeout(hidePreloader, minShowTime);
      }

      if (document.readyState === "complete") {
        triggerExit();
      } else {
        window.addEventListener("load", triggerExit, { once: true });
        // Fallback max 3 secondi nel caso l'evento 'load' tardi a scattare
        setTimeout(hidePreloader, 3000);
      }
    }

    function init() {
      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          setTimeout(buildScribble, 50);
        });
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", init);
    } else {
      init();
    }
  })();
</script>

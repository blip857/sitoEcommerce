---
/**
 * @file Preloader.astro
 * @description Cinematic intro preloader — doberman hero-style image emerges from darkness.
 *              Phase 1 (0.2s):  GIF appears at near-invisible opacity (opacity-20).
 *              Phase 2 (1.2s):  GIF rises to full opacity-100 over 2000ms CSS transition.
 *              Phase 3 (3.8s):  Full overlay fades out (duration-700), removed from DOM at 4.5s.
 *              Runs once per user session via sessionStorage ('intro-visto').
 */
---

<div
  id="preloader-container"
  class="fixed inset-0 z-[9999] bg-black flex items-center justify-center select-none"
>
  <!-- Inline script: synchronously hide overlay before first paint if already seen this session -->
  <script is:inline>
    if (sessionStorage.getItem('intro-visto')) {
      document.getElementById('preloader-container').style.display = 'none';
    }
  </script>

  <!-- Hero-sized doberman image, starts invisible -->
  <img
    id="preloaderGif"
    src="/assets/doberman.webp"
    alt="Doberman"
    class="w-full max-w-[1200px] h-[50vh] md:h-[70vh] object-cover opacity-0 transition-all duration-[2000ms] ease-out select-none pointer-events-none"
  />
</div>

<script>
  const container = document.getElementById('preloader-container');
  const gif = document.getElementById('preloaderGif');

  // Bail out immediately if already seen this session
  if (sessionStorage.getItem('intro-visto')) {
    container?.remove();
  } else {
    // Lock session so this intro won't replay on subsequent navigation
    sessionStorage.setItem('intro-visto', 'true');

    // Phase 1 (0.2s): GIF materialises at near-invisible opacity
    setTimeout(() => {
      gif?.classList.add('opacity-20');
    }, 200);

    // Phase 2 (1.2s): GIF rises to full opacity — 2000ms CSS transition handles the gradual emergence
    setTimeout(() => {
      gif?.classList.remove('opacity-20');
      gif?.classList.add('opacity-100');
    }, 1200);

    // Phase 3 (3.8s): Overlay fades out elegantly, revealing the homepage beneath
    setTimeout(() => {
      container?.classList.add('opacity-0', 'pointer-events-none', 'transition-opacity', 'duration-700');

      // Remove node from DOM after fade completes
      setTimeout(() => {
        container?.remove();
      }, 700);
    }, 3800);
  }
</script>

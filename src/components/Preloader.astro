---
/**
 * @file Preloader.astro
 * @description Cinematic intro preloader.
 *              Phase 1: brand text fades in.
 *              Phase 2: text fades out, doberman image fades in.
 *              Phase 3: full overlay fades out and is removed from DOM.
 *              Runs once per user session via sessionStorage.
 */
---

<div
  id="preloader-container"
  class="fixed inset-0 z-[9999] bg-black flex items-center justify-center select-none transition-opacity duration-500"
>
  <!-- Inline script: synchronously hide the overlay before paint if already seen this session -->
  <script is:inline>
    if (sessionStorage.getItem('intro-visto')) {
      document.getElementById('preloader-container').style.display = 'none';
    }
  </script>

  <!-- Centered wrapper — both children are absolute and stacked on top of each other -->
  <div class="relative flex items-center justify-center w-full h-full">

    <!-- Brand Text Element -->
    <h1
      id="preloader-text"
      class="text-4xl md:text-6xl font-black tracking-widest text-zinc-100 opacity-0 transition-opacity duration-700 ease-in-out absolute select-none pointer-events-none"
    >
      OCCHIPIENIDI
    </h1>

    <!-- Doberman Image Element -->
    <img
      id="preloader-gif"
      src="/assets/doberman.webp"
      alt="Doberman"
      class="max-w-[90vw] md:max-w-[500px] h-auto object-contain opacity-0 transition-opacity duration-700 ease-in-out absolute pointer-events-none"
    />

  </div>
</div>

<script>
  const container = document.getElementById('preloader-container');
  const textEl = document.getElementById('preloader-text');
  const gifEl = document.getElementById('preloader-gif');

  // If already seen this session, bail out immediately
  if (sessionStorage.getItem('intro-visto')) {
    container?.remove();
  } else {
    // Mark session so this intro won't replay on subsequent navigation
    sessionStorage.setItem('intro-visto', 'true');

    // Phase 1 (0.2s): Brand text fades in
    setTimeout(() => {
      textEl?.classList.add('opacity-100');
    }, 200);

    // Phase 2 (1.5s): Text fades out, doberman image fades in
    setTimeout(() => {
      textEl?.classList.remove('opacity-100');
      gifEl?.classList.add('opacity-100');
    }, 1500);

    // Phase 3 (4.0s): Full overlay fades out
    setTimeout(() => {
      container?.classList.add('opacity-0', 'pointer-events-none');

      // Remove from DOM after fade transition completes (500ms)
      setTimeout(() => {
        container?.remove();
      }, 500);
    }, 4000);
  }
</script>

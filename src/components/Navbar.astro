---
// Source of Truth: all country/currency data is imported from the central SSoT registry.
import CartDrawer from './CartDrawer.astro';
import { ECOMMERCE_REGISTRY } from '../config/ecommerce.config';
---

<nav class="navbar">
    <div class="nav-left">
        <button class="mobile-icon menu-hamburger" aria-label="Apri menu">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2.5" fill="none">
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>
        <button class="mobile-icon menu-search" aria-label="Cerca">
            <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2.5" fill="none">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>
        <div class="desktop-items">
            <div class="dropdown">
                <a href="#" class="dropdown-trigger">VESTIARIO ▾</a>
                <div class="dropdown-menu">
                    <a href="#">Visualizza Tutto</a>
                    <a href="#">Magliette</a>
                    <a href="#">Felpe</a>
                </div>
            </div>
            <div class="dropdown">
                <a href="#" class="dropdown-trigger">ACCESSORI ▾</a>
                <div class="dropdown-menu">
                    <a href="#">Berretti</a>
                    <a href="#">Adesivi</a>
                </div>
            </div>
            <a href="/contatti">CONTATTI</a>
        </div>
    </div>

    <div class="nav-center">
        <span class="logo-placeholder">OcchiPieniDi</span>
    </div>

    <div class="nav-right">
        <!-- ICONE MOBILE (visibili sotto i 1024px) -->
        <a href="#" class="mobile-icon menu-profile" aria-label="Account">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </a>
        <button class="mobile-icon menu-cart btn-cart" aria-label="Carrello">
            <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
        </button>

        <div class="desktop-items">
            <div class="currency-picker">
                <button class="currency-trigger" id="currencyBtn" aria-haspopup="listbox" aria-expanded="false">
                    <span class="current-selected-text">Italia (EUR €)</span>
                    <span class="chevron-arrow">＾</span>
                </button>

                <div class="disclosure__list-wrapper country-selector" id="currencyDropdown">
                    <div class="country-filter">
                        <div class="field">
                            <input class="country-filter__input field__input" id="country-filter-input" type="search" placeholder="Search" autocomplete="off" spellcheck="false" />
                            <button type="reset" class="country-filter__reset-button field__button hidden" id="filterResetBtn" aria-label="Clear search">
                                <svg fill="none" stroke="currentColor" class="icon icon-close" viewBox="0 0 18 18">
                                    <circle cx="9" cy="9" r="8.5" stroke-opacity=".2"></circle>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11.83 11.83 6.172 6.17M6.229 11.885l5.544-5.77"></path>
                                </svg>
                            </button>
                            <div class="country-filter__search-icon field__button">
                                <svg fill="none" class="icon icon-search" viewBox="0 0 18 19">
                                    <path fill="currentColor" fill-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 1 1 2.85 3.5a5.784 5.784 0 0 1 8.18 8.18m.26 1.12a6.78 6.78 0 1 1 .72-.7l5.4 5.4a.5.5 0 1 1-.71.7z" clip-rule="evenodd"></path>
                                </svg>
                            </div>
                        </div>
                        <button class="country-selector__close-button" id="closeDropdownBtn" type="button" aria-label="Close">
                            <svg fill="none" class="icon icon-close" viewBox="0 0 18 17">
                                <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"></path>
                            </svg>
                        </button>
                    </div>

                    <div class="disclosure__list country-selector__list">
                        <ul role="list" class="list-unstyled countries" id="countryList">
                            {ECOMMERCE_REGISTRY.map((country) => (
                                <li class="disclosure__item" tabindex="-1">
                                    <a class="disclosure__link" href="#" data-value={country.code} id={`Navbar-${country.englishName}`}>
                                        <span class={`checkmark-wrapper ${country.code === "IT" ? "" : "visibility-hidden"}`}>
                                            <svg viewBox="0 0 12 9" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 4.5L4 7.5L11 1" stroke-linecap="round" stroke-linejoin="round"/>
                                            </svg>
                                        </span>
                                        <span class="country">{country.name}</span>
                                        <span class="localization-form__currency">{country.currencyCode} {country.currencySymbol}</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                </div>
            </div>

            <a href="#" class="icon-link" aria-label="Cerca">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
            </a>
            <a href="#" class="icon-link" aria-label="Account">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                </svg>
            </a>
            <a href="#" class="icon-link btn-wagen" aria-label="Carrello">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2.5" fill="none">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <path d="M16 10a4 4 0 0 1-8 0"></path>
                </svg>
            </a>
        </div>
    </div>
</nav>

<CartDrawer />

<!-- MOBILE MENU OVERLAY -->
<div class="mobile-menu-overlay" id="mobileMenuOverlay">
    <div class="mobile-menu-items">
        <!-- VESTIARIO ACCORDION -->
        <div class="mobile-menu-item">
            <div class="menu-row">
                <a href="#">VESTIARIO</a>
                <button class="submenu-toggle" aria-label="Espandi sottomenù Vestiario" aria-expanded="false">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" class="chevron-icon">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </div>
            <div class="mobile-submenu">
                <a href="#">Magliette</a>
                <a href="#">Felpe</a>
                <a href="#">Visualizza tutto</a>
            </div>
        </div>

        <!-- ACCESSORI ACCORDION -->
        <div class="mobile-menu-item">
            <div class="menu-row">
                <a href="#">ACCESSORI</a>
                <button class="submenu-toggle" aria-label="Espandi sottomenù Accessori" aria-expanded="false">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" class="chevron-icon">
                        <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                </button>
            </div>
            <div class="mobile-submenu">
                <a href="#">Berretti</a>
                <a href="#">Adesivi</a>
            </div>
        </div>

        <!-- CONTATTI LINK -->
        <div class="mobile-menu-item">
            <div class="menu-row">
                <a href="/contatti">CONTATTI</a>
            </div>
        </div>
    </div>
</div>

<script>
    function initAdvancedCurrencyPicker() {
        const btn = document.getElementById("currencyBtn");
        const dropdown = document.getElementById("currencyDropdown");
        const searchInput = document.getElementById("country-filter-input") as HTMLInputElement | null;
        const resetBtn = document.getElementById("filterResetBtn");
        const closeBtn = document.getElementById("closeDropdownBtn");
        const listItems = document.querySelectorAll("#countryList .disclosure__item");
        const currentText = document.querySelector(".current-selected-text");

        if (!btn || !dropdown || !searchInput || !currentText || !resetBtn || !closeBtn) return;

        const toggleDropdown = (show: boolean) => {
            if (show) {
                dropdown.classList.add("active");
                btn.setAttribute("aria-expanded", "true");
                setTimeout(() => searchInput.focus(), 50);
            } else {
                dropdown.classList.remove("active");
                btn.setAttribute("aria-expanded", "false");
            }
        };

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleDropdown(!dropdown.classList.contains("active"));
        });
        closeBtn.addEventListener("click", () => toggleDropdown(false));

        document.addEventListener("click", (e) => {
            const target = e.target as Node;
            if (!dropdown.contains(target) && !btn.contains(target)) toggleDropdown(false);
        });

        searchInput.addEventListener("input", () => {
            const term = searchInput.value.toLowerCase().trim();
            if (term.length > 0) { resetBtn.classList.remove("hidden"); } else { resetBtn.classList.add("hidden"); }

            listItems.forEach((item) => {
                const itemEl = item as HTMLElement;
                const countrySpan = itemEl.querySelector(".country");
                const countryName = countrySpan?.textContent?.toLowerCase() || "";
                if (countryName.includes(term)) { itemEl.style.display = "block"; } else { itemEl.style.display = "none"; }
            });
        });

        resetBtn.addEventListener("click", () => {
            searchInput.value = "";
            resetBtn.classList.add("hidden");
            listItems.forEach((item) => ((item as HTMLElement).style.display = "block"));
            searchInput.focus();
        });

        listItems.forEach((item) => {
            const link = item.querySelector(".disclosure__link") as HTMLElement;
            if (!link) return;

            link.addEventListener("click", (e) => {
                e.preventDefault();
                const countryCode = link.getAttribute("data-value") || "IT";
                const countryName = link.querySelector(".country")?.textContent?.trim() || "";
                const currencyName = link.querySelector(".localization-form__currency")?.textContent?.trim() || "";

                localStorage.setItem("user-country-code", countryCode);
                localStorage.setItem("user-country-name", countryName);
                localStorage.setItem("user-currency", currencyName);

                window.dispatchEvent(new CustomEvent("app:currency-change", { detail: { code: countryCode, name: countryName, currency: currencyName } }));
                toggleDropdown(false);
                searchInput.value = "";
                resetBtn.classList.add("hidden");
                listItems.forEach((i) => ((i as HTMLElement).style.display = "block"));
            });
        });

        const updateNavbarUI = (code: string, name: string, currency: string) => {
            currentText.textContent = `${name} (${currency})`;
            document.querySelectorAll(".checkmark-wrapper").forEach((cw) => cw.classList.add("visibility-hidden"));
            const activeLink = document.querySelector(`#countryList .disclosure__link[data-value="${code}"]`);
            activeLink?.querySelector(".checkmark-wrapper")?.classList.remove("visibility-hidden");
        };

        window.addEventListener("app:currency-change", (e: any) => {
            const { code, name, currency } = e.detail;
            updateNavbarUI(code, name, currency);
        });

        const savedCode = localStorage.getItem("user-country-code");
        const savedName = localStorage.getItem("user-country-name");
        const savedCurrency = localStorage.getItem("user-currency");
        if (savedCode && savedName && savedCurrency) { updateNavbarUI(savedCode, savedName, savedCurrency); }
    }

    function initMobileMenu() {
        const hamburger = document.querySelector(".menu-hamburger");
        const overlay = document.getElementById("mobileMenuOverlay");
        const toggles = document.querySelectorAll(".submenu-toggle");

        if (!hamburger || !overlay) return;

        hamburger.classList.remove("active");
        overlay.classList.remove("active");
        document.body.style.overflow = "";

        if (overlay.getAttribute("data-initialized") === "true") return;
        overlay.setAttribute("data-initialized", "true");

        hamburger.addEventListener("click", () => {
            const isActive = hamburger.classList.toggle("active");
            overlay.classList.toggle("active");
            if (isActive) {
                document.body.style.overflow = "hidden";
            } else {
                document.body.style.overflow = "";
            }
        });

        toggles.forEach(toggle => {
            toggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const parent = toggle.closest(".mobile-menu-item");
                const submenu = parent?.querySelector(".mobile-submenu") as HTMLElement;
                if (parent && submenu) {
                    const isOpen = parent.classList.toggle("open");
                    if (isOpen) {
                        submenu.style.maxHeight = submenu.scrollHeight + "px";
                        toggle.setAttribute("aria-expanded", "true");
                    } else {
                        submenu.style.maxHeight = "0px";
                        toggle.setAttribute("aria-expanded", "false");
                    }
                }
            });
        });
    }

    initAdvancedCurrencyPicker();
    initMobileMenu();

    document.addEventListener("astro:page-load", () => {
        const overlay = document.getElementById("mobileMenuOverlay");
        if (overlay) {
            overlay.removeAttribute("data-initialized");
        }
        initAdvancedCurrencyPicker();
        initMobileMenu();
    });
</script>

<style>
    .navbar { background-color: #111111; color: white; display: flex; justify-content: space-between; align-items: center; padding: 0 24px; height: 70px; font-family: sans-serif; font-weight: bold; font-size: 0.85rem; letter-spacing: 1px; border-bottom: 1px solid #1a1a1a; position: relative; z-index: 100; }
    .nav-left, .nav-right, .desktop-items { display: flex; align-items: center; gap: 24px; }
    .navbar a { color: white; text-decoration: none; transition: color 0.2s; }
    .navbar a:hover, .icon-link:hover { color: #ff9f00; }
    .icon-link { color: white; display: inline-flex; align-items: center; }
    .btn-wagen { border-left: 1px solid #333; padding-left: 24px; }
    .logo-placeholder { font-size: 1.2rem; letter-spacing: 3px; font-weight: 900; text-transform: uppercase; }
    .mobile-icon {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        display: none !important;
        text-decoration: none;
        align-items: center;
        justify-content: center;
    }
    .currency-picker { position: relative; display: inline-block; }
    .currency-trigger { background: transparent; border: none; color: white; font-family: sans-serif; font-size: 0.85rem; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 6px; }
    .chevron-arrow { font-size: 0.6rem; transform: rotate(180deg); transition: transform 0.2s; }
    .currency-trigger[aria-expanded="true"] .chevron-arrow { transform: rotate(0deg); }
    .disclosure__list-wrapper { position: absolute; top: calc(100% + 15px); right: 0; background-color: #000000; border: 1px solid #222; width: 320px; display: none; flex-direction: column; box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.7); z-index: 999; }
    .disclosure__list-wrapper.active { display: flex; }
    .country-filter { display: flex; align-items: center; padding: 12px; gap: 8px; border-bottom: 1px solid #222; }
    .field { position: relative; flex-grow: 1; display: flex; align-items: center; }
    .field__input { width: 100%; background: #111; border: 1px solid #444; color: white; padding: 8px 32px 8px 32px; font-size: 0.85rem; outline: none; }
    .field__input:focus { border-color: #ff9f00; }
    .field__button { position: absolute; background: none; border: none; color: #888; cursor: pointer; display: flex; align-items: center; }
    .country-filter__search-icon { left: 10px; pointer-events: none; }
    .country-filter__reset-button { right: 10px; color: white; }
    .country-filter__reset-button svg, .country-filter__search-icon svg { width: 14px; height: 14px; }
    .country-selector__close-button { background: none; border: none; color: #888; cursor: pointer; padding: 4px; }
    .country-selector__close-button:hover { color: white; }
    .country-selector__close-button svg { width: 16px; height: 16px; }
    .disclosure__list { max-height: 250px; overflow-y: auto; }
    .list-unstyled { list-style: none; padding: 0; margin: 0; }
    .disclosure__link { display: flex; align-items: center; padding: 10px 16px; color: #ccc !important; font-size: 0.9rem; font-weight: normal; transition: background 0.15s; }
    .disclosure__link:hover { background-color: #161616; color: white !important; }
    .checkmark-wrapper { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; margin-right: 12px; color: #ff9f00; flex-shrink: 0; }
    .checkmark-wrapper svg { width: 12px; height: 12px; }
    .country { flex-grow: 1; text-align: left; }
    .localization-form__currency { color: #666; font-size: 0.8rem; margin-left: 8px; }
    .hidden { display: none !important; }
    .visibility-hidden { opacity: 0; pointer-events: none; }
    .disclosure__list::-webkit-scrollbar { width: 6px; }
    .disclosure__list::-webkit-scrollbar-track { background: #000; }
    .disclosure__list::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
    .disclosure__list::-webkit-scrollbar-thumb:hover { background: #555; }

    .dropdown { position: relative; display: inline-block; }
    .dropdown-trigger { cursor: pointer; }
    .dropdown-menu { position: absolute; top: calc(100% + 15px); left: 0; background-color: #000000; border: 1px solid #222; min-width: 180px; display: none; flex-direction: column; box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.7); z-index: 999; padding: 6px 0; }
    .dropdown-menu a { padding: 10px 16px; color: #ccc !important; font-size: 0.8rem; font-weight: normal; letter-spacing: 0.5px; text-transform: none; display: block; transition: background 0.15s, color 0.15s; }
    .dropdown-menu a:hover { background-color: #161616; color: #ff9f00 !important; }
    .dropdown:hover .dropdown-menu { display: flex; }
    .dropdown::after { content: ""; position: absolute; top: 100%; left: 0; width: 100%; height: 18px; }

    /* Hamburger to X transition */
    .menu-hamburger svg line {
        transition: transform 0.3s ease, opacity 0.3s ease;
        transform-origin: 12px 12px;
    }
    .menu-hamburger.active svg line:nth-child(1) {
        transform: translateY(6px) rotate(45deg);
    }
    .menu-hamburger.active svg line:nth-child(2) {
        opacity: 0;
    }
    .menu-hamburger.active svg line:nth-child(3) {
        transform: translateY(-6px) rotate(-45deg);
    }

    /* Mobile Menu Overlay */
    .mobile-menu-overlay {
        position: fixed;
        top: 60px;
        left: 0;
        width: 100%;
        height: calc(100vh - 60px);
        height: calc(100dvh - 60px);
        background-color: #111111;
        z-index: 90;
        transform: translateX(-100%);
        transition: transform 0.3s ease-in-out;
        overflow-y: auto;
        padding: 24px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
    }

    .mobile-menu-overlay.active {
        transform: translateX(0);
    }

    @media (min-width: 1025px) {
        .mobile-menu-overlay {
            display: none !important;
        }
    }

    /* Accordion Menu */
    .mobile-menu-items {
        display: flex;
        flex-direction: column;
        width: 100%;
    }

    .mobile-menu-item {
        border-bottom: 1px solid #222;
    }

    .menu-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 0;
    }

    .menu-row a {
        font-family: sans-serif;
        font-size: 1rem;
        font-weight: bold;
        letter-spacing: 1.5px;
        color: white;
        text-decoration: none;
        text-transform: uppercase;
        flex-grow: 1;
        transition: color 0.2s;
    }

    .menu-row a:hover {
        color: #ff9f00;
    }

    .submenu-toggle {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        padding: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: color 0.2s;
    }

    .submenu-toggle:hover {
        color: #ff9f00;
    }

    .chevron-icon {
        transition: transform 0.3s ease;
    }

    .mobile-menu-item.open .chevron-icon {
        transform: rotate(180deg);
    }

    .mobile-submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s ease-out;
        display: flex;
        flex-direction: column;
        gap: 12px;
        padding-left: 16px;
    }

    .mobile-submenu a {
        font-family: sans-serif;
        font-size: 0.9rem;
        font-weight: normal;
        color: #888;
        text-decoration: none;
        padding: 6px 0;
        transition: color 0.2s, padding-left 0.2s;
    }

    .mobile-submenu a:hover {
        color: #ff9f00;
        padding-left: 4px;
    }

    .mobile-submenu a:first-child {
        padding-top: 2px;
    }

    .mobile-submenu a:last-child {
        padding-bottom: 18px;
    }

    @media (max-width: 1024px) {
        .desktop-items { display: none !important; }
        .mobile-icon { display: inline-flex !important; }
        .navbar { padding: 0 16px; height: 60px; }
        .logo-placeholder { font-size: 1rem; }
        .nav-left, .nav-right { gap: 16px; }
    }
</style>

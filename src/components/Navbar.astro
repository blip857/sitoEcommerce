<script>
    function initAdvancedCurrencyPicker() {
        const btn = document.getElementById("currencyBtn");
        const dropdown = document.getElementById("currencyDropdown");
        const searchInput = document.getElementById(
            "country-filter-input",
        ) as HTMLInputElement | null;
        const resetBtn = document.getElementById("filterResetBtn");
        const closeBtn = document.getElementById("closeDropdownBtn");
        const listItems = document.querySelectorAll(
            "#countryList .disclosure__item",
        );
        const currentText = document.querySelector(".current-selected-text");

        if (
            !btn ||
            !dropdown ||
            !searchInput ||
            !currentText ||
            !resetBtn ||
            !closeBtn
        )
            return;

        const toggleDropdown = (show: boolean) => {
            if (show) {
                dropdown.classList.add("active");
                btn.setAttribute("aria-expanded", "true");
                setTimeout(() => searchInput.focus(), 50);
            } else {
                dropdown.classList.remove("active");
                btn.setAttribute("aria-expanded", "false");
            }
        };

        btn.addEventListener("click", (e) => {
            e.stopPropagation();
            toggleDropdown(!dropdown.classList.contains("active"));
        });
        closeBtn.addEventListener("click", () => toggleDropdown(false));

        document.addEventListener("click", (e) => {
            const target = e.target as Node;
            if (!dropdown.contains(target) && !btn.contains(target))
                toggleDropdown(false);
        });

        searchInput.addEventListener("input", () => {
            const term = searchInput.value.toLowerCase().trim();
            if (term.length > 0) {
                resetBtn.classList.remove("hidden");
            } else {
                resetBtn.classList.add("hidden");
            }

            listItems.forEach((item) => {
                const itemEl = item as HTMLElement;
                const countrySpan = itemEl.querySelector(".country");
                const countryName =
                    countrySpan?.textContent?.toLowerCase() || "";
                if (countryName.includes(term)) {
                    itemEl.style.display = "block";
                } else {
                    itemEl.style.display = "none";
                }
            });
        });

        resetBtn.addEventListener("click", () => {
            searchInput.value = "";
            resetBtn.classList.add("hidden");
            listItems.forEach(
                (item) => ((item as HTMLElement).style.display = "block"),
            );
            searchInput.focus();
        });

        // AGGIORNAMENTO LOGICA SELEZIONE NAZIONE CON EVENTO GLOBALE
        listItems.forEach((item) => {
            const link = item.querySelector(".disclosure__link") as HTMLElement;
            if (!link) return;

            link.addEventListener("click", (e) => {
                e.preventDefault();
                const countryCode = link.getAttribute("data-value") || "IT";
                const countryName =
                    link.querySelector(".country")?.textContent?.trim() || "";
                const currencyName =
                    link
                        .querySelector(".localization-form__currency")
                        ?.textContent?.trim() || "";

                // 1. Salva lo stato localmente
                localStorage.setItem("user-country-code", countryCode);
                localStorage.setItem("user-country-name", countryName);
                localStorage.setItem("user-currency", currencyName);

                // 2. Dispaccia l'evento globale per gli altri componenti
                window.dispatchEvent(
                    new CustomEvent("app:currency-change", {
                        detail: {
                            code: countryCode,
                            name: countryName,
                            currency: currencyName,
                        },
                    }),
                );

                toggleDropdown(false);
                searchInput.value = "";
                resetBtn.classList.add("hidden");
                listItems.forEach(
                    (i) => ((i as HTMLElement).style.display = "block"),
                );
            });
        });

        // Sincronizza l'interfaccia grafica in base ai dati dell'evento (es. se cambiato dal footer)
        const updateNavbarUI = (
            code: string,
            name: string,
            currency: string,
        ) => {
            currentText.textContent = `${name} (${currency})`;
            document
                .querySelectorAll(".checkmark-wrapper")
                .forEach((cw) => cw.classList.add("visibility-hidden"));
            const activeLink = document.querySelector(
                `#countryList .disclosure__link[data-value="${code}"]`,
            );
            activeLink
                ?.querySelector(".checkmark-wrapper")
                ?.classList.remove("visibility-hidden");
        };

        // Ascolta i cambiamenti provenienti da altrove
        window.addEventListener("app:currency-change", (e: any) => {
            const { code, name, currency } = e.detail;
            updateNavbarUI(code, name, currency);
        });

        // Inizializzazione allo stato salvato (on load)
        const savedCode = localStorage.getItem("user-country-code");
        const savedName = localStorage.getItem("user-country-name");
        const savedCurrency = localStorage.getItem("user-currency");

        if (savedCode && savedName && savedCurrency) { updateNavbarUI(savedCode, savedName, savedCurrency); }
    }

    function initMobileMenu() {
        const hamburger = document.querySelector(".menu-hamburger");
        const overlay = document.getElementById("mobileMenuOverlay");
        const toggles = document.querySelectorAll(".submenu-toggle");

        if (!hamburger || !overlay) return;

        // Reset to initial closed state on load/page transitions
        hamburger.classList.remove("active");
        overlay.classList.remove("active");
        document.body.style.overflow = "";

        // If already initialized on this DOM element, skip binding to avoid duplicate listeners
        if (overlay.getAttribute("data-initialized") === "true") return;
        overlay.setAttribute("data-initialized", "true");

        hamburger.addEventListener("click", () => {
            const isActive = hamburger.classList.toggle("active");
            overlay.classList.toggle("active");
            if (isActive) {
                document.body.style.overflow = "hidden";
            } else {
                document.body.style.overflow = "";
            }
        });

        toggles.forEach(toggle => {
            toggle.addEventListener("click", (e) => {
                e.stopPropagation();
                const parent = toggle.closest(".mobile-menu-item");
                const submenu = parent?.querySelector(".mobile-submenu") as HTMLElement;
                if (parent && submenu) {
                    const isOpen = parent.classList.toggle("open");
                    if (isOpen) {
                        submenu.style.maxHeight = submenu.scrollHeight + "px";
                        toggle.setAttribute("aria-expanded", "true");
                    } else {
                        submenu.style.maxHeight = "0px";
                        toggle.setAttribute("aria-expanded", "false");
                    }
                }
            });
        });
    }

    // Initial page load
    initAdvancedCurrencyPicker();
    initMobileMenu();

    // Re-bind scripts when Astro view transition completes
    document.addEventListener("astro:page-load", () => {
        const overlay = document.getElementById("mobileMenuOverlay");
        if (overlay) {
            overlay.removeAttribute("data-initialized");
        }
        initAdvancedCurrencyPicker();
        initMobileMenu();
    });
</script>

<style>
    .navbar {
        background-color: #111111;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
        height: 70px;
        font-family: sans-serif;
        font-weight: bold;
        font-size: 0.85rem;
        letter-spacing: 1px;
        border-bottom: 1px solid #1a1a1a;
        position: relative;
        z-index: 100;
    }
    .nav-left,
    .nav-right,
    .desktop-items {
        display: flex;
        align-items: center;
        gap: 24px;
    }
    .navbar a {
        color: white;
        text-decoration: none;
        transition: color 0.2s;
    }
    .navbar a:hover,

---
// Struttura Navbar adattiva (Desktop con scritte / Mobile con icone)
---

<nav class="navbar">
    <!-- ================= BLOCCO SINISTRO ================= -->
    <div class="nav-left">
        <!-- Icone Mobile (Nascoste su Desktop) -->
        <button class="mobile-icon menu-hamburger" aria-label="Apri menu">
            <svg
                viewBox="0 0 24 24"
                width="24"
                height="24"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
            >
                <line x1="3" y1="12" x2="21" y2="12"></line>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <line x1="3" y1="18" x2="21" y2="18"></line>
            </svg>
        </button>

        <button class="mobile-icon menu-search" aria-label="Cerca">
            <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
        </button>

        <!-- Link Desktop (Nascosti su Mobile) -->
        <div class="desktop-items">
            <a href="#">VESTIARIO ▾</a>
            <a href="#">ACCESSORI ▾</a>
            <a href="#">CONTATTI</a>
        </div>
    </div>

    <!-- ================= BLOCCO CENTRALE (LOGO) ================= -->
    <div class="nav-center">
        <span class="logo-placeholder">OcchiPieniDi</span>
    </div>

    <!-- ================= BLOCCO DESTRO ================= -->
    <div class="nav-right">
        <!-- Link Desktop (Nascosti su Mobile) -->
        <div class="desktop-items">
            <a href="#" class="search-desktop">🔍 CERCA</a>
            <a href="#">ACCOUNT</a>
            <a href="#">IT (€) ▾</a>
            <a href="#" class="btn-wagen">CARRELLO</a>
        </div>

        <!-- Icone Mobile (Nascoste su Desktop) -->
        <a href="#" class="mobile-icon menu-user" aria-label="Account">
            <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
            </svg>
        </a>

        <a href="#" class="mobile-icon menu-cart" aria-label="Carrello">
            <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                stroke="currentColor"
                stroke-width="2.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"
                ></path>
                <line x1="3" y1="6" x2="21" y2="6"></line>
                <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
        </a>
    </div>
</nav>

<style>
    /* Base Comune (Sfondo e Font) */
    .navbar {
        background-color: #111111;
        color: white;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 24px;
        height: 70px;
        font-family: sans-serif;
        font-weight: bold;
        font-size: 0.85rem;
        letter-spacing: 1px;
        border-bottom: 1px solid #1a1a1a;
    }

    .nav-left,
    .nav-right,
    .desktop-items {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .navbar a {
        color: white;
        text-decoration: none;
        white-space: nowrap;
        transition: color 0.2s ease;
    }

    .navbar a:hover {
        color: #ff9f00;
    }

    /* Mantenuto inalterato il nome classe per non rompere i collegamenti */
    .btn-wagen {
        border-left: 1px solid #333;
        padding-left: 24px;
    }

    .logo-placeholder {
        font-size: 1.2rem;
        letter-spacing: 3px;
        font-weight: 900;
        text-transform: uppercase;
    }

    button.mobile-icon {
        background: none;
        border: none;
        color: white;
        padding: 0;
        cursor: pointer;
    }

    /* RESPONSIVE TRICK */
    .mobile-icon {
        display: none !important;
    }

    @media (max-width: 1024px) {
        .desktop-items {
            display: none !important;
        }

        .mobile-icon {
            display: inline-flex !important;
            align-items: center;
            justify-content: center;
            color: white;
            transition: color 0.2s;
        }

        .mobile-icon:hover {
            color: #ff9f00;
        }

        .navbar {
            padding: 0 16px;
            height: 60px;
        }

        .logo-placeholder {
            font-size: 1rem;
        }

        .nav-left,
        .nav-right {
            gap: 16px;
        }
    }
</style>

        color: #ff9f00;
    }
    .icon-link {
        color: white;
        display: inline-flex;
        align-items: center;
    }
    .btn-wagen {
        border-left: 1px solid #333;
        padding-left: 24px;
    }
    .logo-placeholder {
        font-size: 1.2rem;
        letter-spacing: 3px;
        font-weight: 900;
        text-transform: uppercase;
    }
    button.mobile-icon {
        background: none;
        border: none;
        color: white;
        cursor: pointer;
        display: none !important;
    }
    .currency-picker {
        position: relative;
        display: inline-block;
    }
    .currency-trigger {
        background: transparent;
        border: none;
        color: white;
        font-family: sans-serif;
        font-size: 0.85rem;
        font-weight: bold;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .chevron-arrow {
        font-size: 0.6rem;
        transform: rotate(180deg);
        transition: transform 0.2s;
    }
    .currency-trigger[aria-expanded="true"] .chevron-arrow {
        transform: rotate(0deg);
    }
    .disclosure__list-wrapper {
        position: absolute;
        top: calc(100% + 15px);
        right: 0;
        background-color: #000000;
        border: 1px solid #222;
        width: 320px;
        display: none;
        flex-direction: column;
        box-shadow: 0px 10px 30px rgba(0, 0, 0, 0.7);
        z-index: 999;
    }
    .disclosure__list-wrapper.active {
        display: flex;
    }
    .country-filter {
        display: flex;
        align-items: center;
        padding: 12px;
        gap: 8px;
        border-bottom: 1px solid #222;
    }
    .field {
        position: relative;
        flex-grow: 1;
        display: flex;
        align-items: center;
    }
    .field__input {
        width: 100%;
        background: #111;
        border: 1px solid #444;
        color: white;
        padding: 8px 32px 8px 32px;
        font-size: 0.85rem;
        outline: none;
    }
    .field__input:focus {
        border-color: #ff9f00;
    }
    .field__button {
        position: absolute;
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        display: flex;
        align-items: center;
    }
    .country-filter__search-icon {
        left: 10px;
        pointer-events: none;
    }
    .country-filter__reset-button {
        right: 10px;
        color: white;
    }
    .country-filter__reset-button svg,
    .country-filter__search-icon svg {
        width: 14px;
        height: 14px;
    }
    .country-selector__close-button {
        background: none;
        border: none;
        color: #888;
        cursor: pointer;
        padding: 4px;
    }
    .country-selector__close-button:hover {
        color: white;
    }
    .country-selector__close-button svg {
        width: 16px;
        height: 16px;
    }
    .disclosure__list {
        max-height: 250px;
        overflow-y: auto;
    }
    .list-unstyled {
        list-style: none;
        padding: 0;
        margin: 0;
    }
    .disclosure__link {
        display: flex;
        align-items: center;
        padding: 10px 16px;
        color: #ccc !important;
        font-size: 0.9rem;
        font-weight: normal;
        transition: background 0.15s;
    }
    .disclosure__link:hover {
        background-color: #161616;
        color: white !important;
    }
    .checkmark-wrapper {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 16px;
        height: 16px;
        margin-right: 12px;
        color: #ff9f00;
        flex-shrink: 0;
    }
    .checkmark-wrapper svg {
        width: 12px;
        height: 12px;
